              - "${test.container}#None-93"
              - "${test.container}#None-94"
              - "${test.container}#None-95"
              - "${test.container}#None-96"
              - "${test.container}#None-97"
              - "${test.container}#None-98"
              - "${test.container}#None-99"
        response:
          statusCode: [200, 422]
          json:
            - pointer: /items
              optional: true
              none:
                - pointer: /id
                  equalsIri: "${one}"

  - id: "#type-search-unrecognized-page-link"
    type: NegativeTest
    name: type-search-unrecognized-page-link
    label: A page link the server does not recognize is answered 404 or 410
    comment: >-
      "A pagination reference (a previously issued page link) that the server no longer recognizes
       or that has expired MUST result in 404 (Not Found) or 410 (Gone)." A test cannot make a link
       expire, so it takes the rel=first link of a search and alters it, giving a link the server
       cannot recognize. Applies when the search response carries rel=first.
    status: Proposed
    level: MUST
    source:
      - https://w3c.github.io/lws-protocol/lws10-index/#type-search-errors
    traits: [Discovery, Get]
    requires: [Authentication]
    requirements:
      - https://example.org/touchstone/req/lws10-index/expired-page-404-410
    steps:
      - label: the storage offers a Type Search Service (otherwise this test does not apply)
        precondition: true
        request:
          method: GET
          url: "${storage}"
          accept: application/lws+cid
        response:
          statusCode: 200
          json:
            - pointer: /service
              some:
                - pointer: /type
                  hasValue: TypeSearchService
      - label: a search names its first page (otherwise this test does not apply)
        precondition: true
        request:
          method: QUERY
          url: "${service.TypeSearchService}"
          contentType: application/lws-query+json
          bodyJSON:
            type: ["${test.container}#Nothing"]
        response:
          statusCode: 200
          linkHeaders:
            - rel: first
              capture: first
      - label: the first-page link, altered, is 404 or 410
        request:
          method: GET
          url: "${first}-touchstone-unrecognized"
          accept: application/lws+json
        response:
          statusCode: [404, 410]

  - id: "#type-search-content-location-protected"
    type: ValidationTest
    name: type-search-content-location-protected
    label: A search result resource named by Content-Location does not hand alice's results to bob
    comment: >-
      RFC 10008 lets a QUERY response name, with Content-Location, a resource that represents its
      results. lws10-index defines no such resource, but "a server that nonetheless exposes one MUST
      subject it to the same authorization filtering on every access and MUST prevent its reuse
      across clients". alice searches for a type only her private resource has. If her answer
      carries a Content-Location, bob fetching it must not see her resource: he may be refused,
      or answered with what he may read, but alice's result set must not reach him. Applies only
      when the search response carries Content-Location. The check reads bob's body for the
      fragment of the type only alice's resource has, which her result carries ("each item ...
      MUST carry at least the matched resource's id and its type"; a precondition makes sure), so
      it holds whether bob's answer is a refusal, empty, or a filtered page. It looks for the type,
      not for a path: a resource's URI need not lie under its container's.
    status: Proposed
    level: MUST
    source:
      - https://w3c.github.io/lws-protocol/lws10-index/#type-search-query
      - https://w3c.github.io/lws-protocol/lws10-index/#security-authorization
    traits: [Discovery, Authz, Private]
    requires: [Authentication]
    requirements:
      - https://example.org/touchstone/req/lws10-index/content-location-protected
    prereqs:
      hierarchy:
        - dataResource: secret
          contentType: text/turtle
          body: "<> a <${test.container}#ContentLocationProtectedSecret> ."
          linkHeaders:
            - rel: type
              href: "${test.container}#ContentLocationProtectedSecret"
    steps:
      - label: the storage offers a Type Search Service (otherwise this test does not apply)
        precondition: true
        request:
          method: GET
          url: "${storage}"
          accept: application/lws+cid
        response:
          statusCode: 200
          json:
            - pointer: /service
              some:
                - pointer: /type
                  hasValue: TypeSearchService
      - label: alice's search finds her resource, with its type (otherwise this test does not apply)
        precondition: true
        poll: {within: 60, every: 3}
        request:
          method: QUERY
          url: "${service.TypeSearchService}"
          contentType: application/lws-query+json
          bodyJSON:
            type: ["${test.container}#ContentLocationProtectedSecret"]
        response:
          statusCode: 200
          json:
            - pointer: /items
              some:
                - pointer: /id
                  equalsIri: "${secret}"
                - pointer: /type
                  hasValue: "${test.container}#ContentLocationProtectedSecret"
      - label: the search response names a result resource (otherwise this test does not apply)
        precondition: true
        request:
          method: QUERY
          url: "${service.TypeSearchService}"
          contentType: application/lws-query+json
          bodyJSON:
            type: ["${test.container}#ContentLocationProtectedSecret"]
        response:
          statusCode: 200
          otherHeaders:
            - headerName: Content-Location
              present: true
              capture: results
      - label: bob, another client, does not get alice's results from it
        as: bob
        request:
          method: GET
          url: "${results}"
        response:
          statusCode: ["2xx", "4xx"]
          bodyMatches: '^(?![\s\S]*#ContentLocationProtectedSecret)'
