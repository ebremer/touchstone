{
  "@context": {
    "@version": 1.1,
    "@protected": true,

    "lwst":    "https://www.w3.org/ns/lws-tests/v1#",
    "mf":      "http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#",
    "rdft":    "http://www.w3.org/ns/rdftest#",
    "rdfs":    "http://www.w3.org/2000/01/rdf-schema#",
    "xsd":     "http://www.w3.org/2001/XMLSchema#",
    "dcterms": "http://purl.org/dc/terms/",

    "id":   "@id",
    "type": "@type",

    "Manifest":         "mf:Manifest",
    "ValidationTest":   "lwst:ValidationTest",
    "NegativeTest":     "lwst:NegativeTest",
    "IdentityRegistry": "lwst:IdentityRegistry",
    "Identity":         "lwst:Identity",

    "label":         "rdfs:label",
    "comment":       "rdfs:comment",
    "name":          "mf:name",
    "entries":       {"@id": "mf:entries", "@container": "@list"},
    "include":       {"@id": "mf:include", "@type": "@id", "@container": "@list"},
    "specification": {"@id": "lwst:specification", "@type": "@id", "@container": "@set"},
    "identities":    {"@id": "lwst:identities", "@container": "@set"},

    "status":   {"@id": "rdft:approval", "@type": "@vocab"},
    "Proposed": "rdft:Proposed",
    "Approved": "rdft:Approved",
    "Rejected": "rdft:Rejected",

    "level":  {"@id": "lwst:level", "@type": "@vocab"},
    "MUST":   "lwst:MUST",
    "SHOULD": "lwst:SHOULD",
    "MAY":    "lwst:MAY",

    "source": {"@id": "dcterms:source", "@type": "@id", "@container": "@set"},

    "traits":             {"@id": "lwst:traits", "@type": "@vocab", "@container": "@set"},
    "Get":                "lwst:Get",
    "Head":               "lwst:Head",
    "Post":               "lwst:Post",
    "Put":                "lwst:Put",
    "Patch":              "lwst:Patch",
    "Delete":             "lwst:Delete",
    "Container":          "lwst:Container",
    "DataResource":       "lwst:DataResource",
    "Linkset":            "lwst:Linkset",
    "StorageDescription": "lwst:StorageDescription",
    "Discovery":          "lwst:Discovery",
    "Authn":              "lwst:Authn",
    "Authz":              "lwst:Authz",
    "Public":             "lwst:Public",
    "Private":            "lwst:Private",
    "Conditional":        "lwst:Conditional",
    "Conneg":             "lwst:Conneg",
    "Range":              "lwst:Range",
    "TokenExchange":      "lwst:TokenExchange",
    "AccessGrants":       "lwst:AccessGrants",
    "Notifications":      "lwst:Notifications",

    "requires":            {"@id": "lwst:requires", "@type": "@vocab", "@container": "@set"},
    "Authentication":      "lwst:Authentication",
    "HarnessIssuedTokens": "lwst:HarnessIssuedTokens",
    "ReachableFixtures":   "lwst:ReachableFixtures",
    "SamlTrust":           "lwst:SamlTrust",

    "as":           {"@id": "lwst:as"},
    "steps":        {"@id": "lwst:steps", "@container": "@list"},
    "precondition": {"@id": "lwst:precondition", "@type": "xsd:boolean"},
    "request":      {"@id": "lwst:request"},
    "response":     {"@id": "lwst:response"},

    "prereqs":       {"@id": "lwst:prereqs"},
    "hierarchy":     {"@id": "lwst:hierarchy", "@container": "@list"},
    "container":     {"@id": "lwst:container"},
    "dataResource":  {"@id": "lwst:dataResource"},
    "in":            {"@id": "lwst:in"},
    "authorization": {"@id": "lwst:authorization"},
    "read":          {"@id": "lwst:read", "@container": "@set"},
    "modify":        {"@id": "lwst:modify", "@container": "@set"},
    "create":        {"@id": "lwst:create", "@container": "@set"},
    "delete":        {"@id": "lwst:delete", "@container": "@set"},

    "method":       {"@id": "lwst:method"},
    "url":          {"@id": "lwst:url"},
    "contentType":  {"@id": "lwst:contentType"},
    "accept":       {"@id": "lwst:accept"},
    "ifMatch":      {"@id": "lwst:ifMatch"},
    "linkHeaders":  {"@id": "lwst:linkHeaders", "@container": "@set"},
    "rel":          {"@id": "lwst:rel"},
    "href":         {"@id": "lwst:href"},
    "mediaType":    {"@id": "lwst:mediaType"},
    "otherHeaders": {"@id": "lwst:otherHeaders", "@container": "@set"},
    "headerName":   {"@id": "lwst:headerName"},
    "headerValue":  {"@id": "lwst:headerValue"},
    "differsFrom":  {"@id": "lwst:differsFrom"},
    "body":         {"@id": "lwst:body"},
    "bodyURL":      {"@id": "lwst:bodyURL", "@type": "@id"},
    "bodyJSON":     {"@id": "lwst:bodyJSON", "@type": "@json"},
    "bodyForm":     {"@id": "lwst:bodyForm", "@type": "@json"},

    "statusCode":              {"@id": "lwst:statusCode", "@container": "@set"},
    "location":                {"@id": "lwst:location"},
    "authenticationChallenge": {"@id": "lwst:authenticationChallenge"},
    "wwwAuthenticate":         {"@id": "lwst:wwwAuthenticate"},
    "asUri":                   {"@id": "lwst:asUri"},
    "realm":                   {"@id": "lwst:realm"},
    "params":                  {"@id": "lwst:params", "@container": "@set"},
    "paramName":               {"@id": "lwst:paramName"},
    "paramValue":              {"@id": "lwst:paramValue"},
    "bodyEmpty":               {"@id": "lwst:bodyEmpty", "@type": "xsd:boolean"},
    "bodyMatches":             {"@id": "lwst:bodyMatches"},
    "json":                    {"@id": "lwst:json", "@container": "@set"},
    "pointer":                 {"@id": "lwst:pointer"},
    "optional":                {"@id": "lwst:optional", "@type": "xsd:boolean"},
    "some":                    {"@id": "lwst:some", "@container": "@set"},
    "every":                   {"@id": "lwst:every", "@container": "@set"},
    "none":                    {"@id": "lwst:none", "@container": "@set"},
    "jwt":                     {"@id": "lwst:jwt"},
    "token":                   {"@id": "lwst:token"},
    "jwks":                    {"@id": "lwst:jwks"},
    "header":                  {"@id": "lwst:header", "@container": "@set"},
    "claims":                  {"@id": "lwst:claims", "@container": "@set"},
    "connegEquivalent":        {"@id": "lwst:connegEquivalent"},
    "accepts":                 {"@id": "lwst:accepts", "@container": "@list"},

    "present":   {"@id": "lwst:present", "@type": "xsd:boolean"},
    "absent":    {"@id": "lwst:absent", "@type": "xsd:boolean"},
    "equals":    {"@id": "lwst:equals", "@type": "@json"},
    "equalsIri": {"@id": "lwst:equalsIri"},
    "matches":   {"@id": "lwst:matches"},
    "hasValue":  {"@id": "lwst:hasValue", "@type": "@json"},
    "exists":    {"@id": "lwst:exists", "@type": "xsd:boolean"},
    "count":     {"@id": "lwst:count", "@type": "xsd:integer"},
    "jsonType":  {"@id": "lwst:jsonType"},
    "capture":   {"@id": "lwst:capture"},
    "cleanup":   {"@id": "lwst:cleanup", "@type": "xsd:boolean"},

    "kind":               {"@id": "lwst:kind", "@type": "@vocab"},
    "NoCredential":       "lwst:NoCredential",
    "StorageAccessToken": "lwst:StorageAccessToken",
    "SubjectCredential":  "lwst:SubjectCredential",
    "suite":              {"@id": "lwst:suite", "@type": "@id"},
    "tokenType":          {"@id": "lwst:tokenType", "@type": "@id"},
    "algorithm":          {"@id": "lwst:algorithm"},
    "webid":              {"@id": "lwst:webid"},
    "basis":              {"@id": "lwst:basis"},
    "credentialHeader":   {"@id": "lwst:credentialHeader", "@type": "@json"},
    "credentialClaims":   {"@id": "lwst:credentialClaims", "@type": "@json"},
    "identityDocument":   {"@id": "lwst:identityDocument", "@type": "@json"},
    "samlAssertion":      {"@id": "lwst:samlAssertion", "@type": "@json"},

    "fault":                               {"@id": "lwst:fault", "@type": "@vocab"},
    "SignatureCorrupted":                  "lwst:SignatureCorrupted",
    "AlgNone":                             "lwst:AlgNone",
    "UnknownKeyId":                        "lwst:UnknownKeyId",
    "Expired":                             "lwst:Expired",
    "NotYetValid":                         "lwst:NotYetValid",
    "IssuedInFuture":                      "lwst:IssuedInFuture",
    "WrongAudience":                       "lwst:WrongAudience",
    "MultipleAudiences":                   "lwst:MultipleAudiences",
    "WrongIssuer":                         "lwst:WrongIssuer",
    "AudienceExcludesAuthorizationServer": "lwst:AudienceExcludesAuthorizationServer",
    "ClientIdMismatch":                    "lwst:ClientIdMismatch",
    "MissingExpiration":                   "lwst:MissingExpiration",
    "MissingIssuedAt":                     "lwst:MissingIssuedAt",
    "MissingAuthorizedParty":              "lwst:MissingAuthorizedParty",
    "UntrustedIssuer":                     "lwst:UntrustedIssuer",
    "Unsigned":                            "lwst:Unsigned"
  }
}
