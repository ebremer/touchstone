<configuration>
  <!-- Without a configuration Logback logs everything at DEBUG, and the self-test loop's
       four runs of every definition made Jetty print some 266,000 lines per build. Warnings
       are what a test run needs to show. -->
  <appender name="console" class="ch.qos.logback.core.ConsoleAppender">
    <target>System.err</target>
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level %logger{24} - %msg%n</pattern>
    </encoder>
  </appender>
  <root level="WARN">
    <appender-ref ref="console"/>
  </root>
</configuration>
