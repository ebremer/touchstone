<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.ebremer.touchstone</groupId>
    <artifactId>touchstone</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>harness-fixtures</artifactId>
  <name>Touchstone :: Fixtures + Reference Server</name>
  <description>Embedded Jetty fixture servers: the in-memory reference LWS server (DECISIONS.md D-0015) now; OIDC issuer, SAML IdP, CID/did:key signer at Phase 4+. Test scope hosts the conformance self-test loop.</description>

  <dependencies>
    <dependency>
      <groupId>org.eclipse.jetty</groupId>
      <artifactId>jetty-server</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <!-- Auth fixtures: mint valid AND deliberately broken tokens, publish JWKS + discovery (DESIGN.md paragraph 4). -->
    <dependency>
      <groupId>com.nimbusds</groupId>
      <artifactId>nimbus-jose-jwt</artifactId>
    </dependency>
    <!-- did:key / CID: hand-rolled Ed25519 self-issued JWTs over BouncyCastle (DESIGN.md paragraph 4). -->
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcprov-jdk18on</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>

    <!-- Self-test loop: run the core executor against the reference server (DESIGN.md paragraph 8). -->
    <dependency>
      <groupId>com.ebremer.touchstone</groupId>
      <artifactId>harness-core</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Run the reference server standalone: mvn -pl harness-fixtures exec:java -Dexec.args=4711 -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <configuration>
          <mainClass>com.ebremer.touchstone.fixtures.lws.RefLwsServerMain</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
