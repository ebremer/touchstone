<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.ebremer.touchstone</groupId>
    <artifactId>touchstone</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>harness-core</artifactId>
  <name>Touchstone :: Core Engine</name>
  <description>Catalog, the YAML-LD definitions loader, the engine that runs them, and reporting. Must stay usable without Spring (DESIGN.md section 3).</description>

  <dependencies>
    <dependency>
      <groupId>org.apache.jena</groupId>
      <artifactId>jena-arq</artifactId>
    </dependency>
    <!-- Direct: the definitions loader expands every document in safe mode, and the conneg
         check parses responses with an offline document loader, both through the Titanium API,
         which jena-arq would otherwise supply only transitively (D-0026). -->
    <dependency>
      <groupId>com.apicatalog</groupId>
      <artifactId>titanium-json-ld</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.dataformat</groupId>
      <artifactId>jackson-dataformat-yaml</artifactId>
    </dependency>
    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
    </dependency>
    <!-- The YAML-LD definitions are YAML 1.2 Core Schema documents. jackson-dataformat-yaml
         (SnakeYAML 1.x) reads YAML 1.1, where yes/on are booleans and 2026-09-21 is a date
         (EXECUTION.md 2.1), so the definitions loader uses snakeyaml-engine. -->
    <dependency>
      <groupId>org.snakeyaml</groupId>
      <artifactId>snakeyaml-engine</artifactId>
    </dependency>
    <!-- The engine mints and checks JWTs itself: harness-issued access tokens and their
         faults, did:key, CID and OpenID subject credentials, and the jwt expectation
         (EXECUTION.md sections 5 and 7.9). -->
    <dependency>
      <groupId>com.nimbusds</groupId>
      <artifactId>nimbus-jose-jwt</artifactId>
    </dependency>
    <dependency>
      <groupId>org.freemarker</groupId>
      <artifactId>freemarker</artifactId>
    </dependency>
    <!-- report.pdf. PDFBox rather than an HTML-to-PDF renderer: the only maintained
         ones are a dormant 1.0.10 and a third-party fork, and report.ftl is HTML5, not
         the XHTML they parse. PdfReport draws from the same model HtmlReport renders,
         so the two cannot disagree about what the run found. -->
    <dependency>
      <groupId>org.apache.pdfbox</groupId>
      <artifactId>pdfbox</artifactId>
    </dependency>
    <!-- Compile-scope by design: the run-to-DynamicTest factory is public API (DESIGN.md section 4). -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <!-- Filter only touchstone.properties; everything else (future fixture graphs etc.) stays verbatim. -->
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
        <includes>
          <include>touchstone.properties</include>
        </includes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
        <excludes>
          <exclude>touchstone.properties</exclude>
        </excludes>
      </resource>
    </resources>
  </build>
</project>
