req:authn-audience-restriction-recommended
    a touchstone:Requirement ;
    touchstone:level "SHOULD" ;
    touchstone:specModule "lws10-core" ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#authentication-data-model> ;
