    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#authentication-data-model> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20260821/#authentication-data-model> ;
    touchstone:summary "The issuer claim is required and its value is a URI." ;
    touchstone:clauseText """issuer REQUIRED — an identifier for the entity that issued the authentication credential. This MUST be a URI.""" ;
    touchstone:clauseHash "sha256-17aca3eb60baf6bfdb9368313da5c0963a0071b980596abf384989c2daea9f2d" ;
