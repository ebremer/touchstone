## ---- authorization ----

req:authz-oauth2-baseline
    a touchstone:Requirement ;
    touchstone:level "MAY" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server, touchstone:AuthorizationServer ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#authorization> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#authorization> ;
    touchstone:summary "OAuth 2.0 is the baseline authorization framework; servers may support additional mechanisms." ;
    touchstone:clauseText """This section defines an authorization framework based on OAuth 2.0 [RFC6749] as the baseline mechanism for obtaining and presenting access tokens. A server MAY support additional authorization mechanisms beyond this baseline.""" ;
    touchstone:clauseHash "sha256-f31618a900386d0869291205a1e0a3a67e80d0354c380446faa8898ffcdc8c9a" ;
    touchstone:status touchstone:Draft ;
