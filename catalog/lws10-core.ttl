## ---- LWS media type: content negotiation ------------------------------------

## Successor to the Gate-1 seed req:container-representation-conneg, whose clause the
## 21 August 2026 draft no longer carries: content negotiation moved out of Operations
## into 12.1.1 Media Type Equivalence and was restated. Same obligation, new words, so
## the Approved status carries over with it (DECISIONS.md D-0040).
req:conneg-media-type-equivalence
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#media-type-equivalence> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20260821/#media-type-equivalence> ;
    touchstone:summary "Container representations are equivalent across application/lws+json, application/ld+json and application/json: one body, and the Content-Type echoes the requested type." ;
    touchstone:clauseText """For container representations, the media types application/lws+json, application/ld+json, and application/json are equivalent: the response body is the same JSON-LD document conforming to the container representation structure defined in 8.1 Container Representation, and only the Content-Type response header varies. Servers MUST honor a request for any of these media types and MUST set the Content-Type response header to the requested media type.""" ;
    touchstone:clauseHash "sha256-81f9c890ab84fda70352822afa6d986eaacfdc34673105c20b6a220b0c1a4500" ;
    touchstone:status touchstone:Approved ;
    dcterms:created "2026-09-02"^^xsd:date .

## ---- Operations: create -----------------------------------------------------

req:create-post-201-location-links
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#create-resource> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20260821/#create-resource> ;
    touchstone:summary "POST create returns 201 with Location and atomic server-managed Link metadata (rel=up, rel=linkset)." ;
    touchstone:clauseText """On success, the server MUST return the 201 status code with the new URI in the Location header. The server MUST include Link headers for key server-managed metadata, including a link to the parent container (rel="up"), and a link to the created resource's dedicated linkset resource (rel="linkset"; type="application/linkset+json"). Additional links SHOULD include rel="type" (indicating https://www.w3.org/ns/lws#Container or https://www.w3.org/ns/lws#DataResource). The body MAY be empty or include a minimal representation of the resource. All metadata creation and linking MUST be atomic with the resource creation to maintain consistency.""" ;
    touchstone:clauseHash "sha256-6808523b25cc42196caf104571dd803d918e6237c1778147d809e65ace11dd87" ;
    touchstone:status touchstone:Approved ;
    dcterms:created "2026-07-16"^^xsd:date .

req:create-container-type-link
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#create-resource> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20260821/#create-resource> ;
    touchstone:summary "Creating a container is signalled by a request Link header rel=type pointing at lws#Container; the server materializes a container accordingly." ;
    touchstone:clauseText """To create a Container, the client MUST include a Link header with rel="type" pointing to the Container type: Link: <https://www.w3.org/ns/lws#Container>; rel="type".""" ;
    touchstone:clauseHash "sha256-073d51753989299e576520bf2f9338edbd10d810f301f3dc8fff5082dbf50516" ;
    touchstone:status touchstone:Approved ;
    dcterms:created "2026-07-16"^^xsd:date .

req:create-post-missing-container-404
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#create-resource> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20260821/#create-resource> ;
    touchstone:summary "POST into a nonexistent container yields 404 unless another status code is more appropriate." ;
    touchstone:clauseText """If the target container /alice/notes/ does not exist, the server MUST return a 404 error status unless another status code is more appropriate.""" ;
    touchstone:clauseHash "sha256-e147ae5ad9a2d926b69f88ed76b5015edca88f1cb8a5bb31d3798ee252af5928" ;
    touchstone:status touchstone:Approved ;
    dcterms:created "2026-07-16"^^xsd:date .

## ---- Operations: read -------------------------------------------------------

req:get-data-resource-content-range-etag
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#read-resource> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20260821/#read-resource> ;
    touchstone:summary "GET on a data resource returns 200 with the stored Content-Type; range-request support and an ETag header are mandatory." ;
    touchstone:clauseText """GET (non-container resource) – Retrieve a resource's content: Send GET to the resource URI for full content (if authorized). Respond with 200 OK, body containing the data, and Content-Type matching the stored media type. Servers MUST support range requests per [RFC7233] for partial retrieval. Responses MUST include an ETag header for concurrency control and caching.""" ;
    touchstone:clauseHash "sha256-c8de0ac1f9d995f68a38bb1dc01a6d1db08bf3e8467831251e099db162e07e7d" ;
    touchstone:status touchstone:Approved ;
    dcterms:created "2026-07-16"^^xsd:date .

req:head-parity-with-get
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#read-resource> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20260821/#read-resource> ;
    touchstone:summary "HEAD is supported for containers and data resources, returning the same headers as GET without a body." ;
    touchstone:clauseText """HEAD (any resource or container) – Headers/metadata only: The LWS server MUST support HEAD [RFC9110] for both containers and non-containers, returning the same headers as GET (including ETag, Content-Type, Link for metadata) but without a body. This enables metadata retrieval without transferring content.""" ;
    touchstone:clauseHash "sha256-68df4be5a9359bcda0b64ecb77bf06aa3820565e0cfe3d25a79a5da556f943a9" ;
    touchstone:status touchstone:Approved ;
    dcterms:created "2026-07-16"^^xsd:date .

req:etag-on-get-head-conditional-304
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#read-resource> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20260821/#read-resource> ;
    touchstone:summary "Conditional requests (If-None-Match / If-Modified-Since) are supported with 304 on no change; ETags appear on all GET/HEAD responses." ;
    touchstone:clauseText """Caching and Conditional Requests: LWS leverages HTTP caching semantics. Servers MUST support conditional requests via If-None-Match (with ETags) or If-Modified-Since headers. If the resource or container listing has not changed, respond with 304 Not Modified to avoid redundant transfers. ETags MUST be provided in all GET/HEAD responses for concurrency and caching support.""" ;
    touchstone:clauseHash "sha256-10ebba3d994057e0309c0de16bb96751ac96652bb23dd1b83a4c0798cec4514b" ;
    touchstone:status touchstone:Approved ;
    dcterms:created "2026-07-16"^^xsd:date .

## ---- Operations: update -----------------------------------------------------

req:put-unconditional-rejected-428
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#update-resource> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20260821/#update-resource> ;
    touchstone:summary "Where a server supports ETags for a resource, an unconditional PUT lacking If-Match is rejected with 428 Precondition Required." ;
    touchstone:clauseText """PUT (replace full resource) – Send PUT to the resource URI with new full content in the body and matching Content-Type (generally consistent with existing type). PUT is idempotent for existing resources. For safety, include If-Match with current ETag (per Section 7.3 concurrency); mismatch yields 412 Precondition Failed or 409 Conflict. Without checks, updates are unconditional but risk overwriting concurrent changes. If a server supports Etags for a resource, it MUST reject unconditional PUT requests that lack an If-Match header with a 428 Precondition Required response.""" ;
    touchstone:clauseHash "sha256-925d08e6ae052c6f90911aef2c70f365e79df9517c22cacf4b34988035c1e6ad" ;
    touchstone:status touchstone:Approved ;
    dcterms:created "2026-07-16"^^xsd:date .

req:patch-json-merge-patch-baseline
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#update-resource> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20260821/#update-resource> ;
    touchstone:summary "PATCH minimally supports JSON Merge Patch (application/merge-patch+json)." ;
    touchstone:clauseText """LWS server MUST minimally support JSON Merge Patch (application/merge-patch+json) as defined in [RFC7386].""" ;
    touchstone:clauseHash "sha256-dec83413eea5e4ad4a005f478adc2dc443d362d5f33d301add64919aeebefab7" ;
    touchstone:status touchstone:Approved ;
    dcterms:created "2026-07-16"^^xsd:date .

## ---- Operations: resource metadata ------------------------------------------

req:link-up-on-non-root-resources
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#metadata> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20260821/#metadata> ;
    touchstone:summary "Every response for a non-root resource carries a Link header rel=up pointing at the parent container." ;
    touchstone:clauseText """Containment: Servers MUST include a Link header with rel="up" pointing to the parent container for any non-root resource.""" ;
    touchstone:clauseHash "sha256-f3a3a7b44d554d76cc9080e408b6d979fe29fa15f6280c278118b8a7477c562b" ;
    touchstone:status touchstone:Approved ;
    dcterms:created "2026-07-16"^^xsd:date .

req:linkset-accept-patch-advertised
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#metadata> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20260821/#metadata> ;
    touchstone:summary "Servers advertise JSON Merge Patch support on the linkset resource via the Accept-Patch header." ;
    touchstone:clauseText """Patch Format Discovery: Servers MUST advertise support for JSON Merge Patch [RFC7386] via the Accept-Patch header: Accept-Patch: application/merge-patch+json.""" ;
    touchstone:clauseHash "sha256-0d70cad8f31a640786775c6f113c3d52fafe73e4227faaea0cddd74bbd9cd6e7" ;
    touchstone:status touchstone:Approved ;
    dcterms:created "2026-07-16"^^xsd:date .

## ---- Operations: delete ------------------------------------------------------

req:delete-non-empty-container-409-depth
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#delete-resource> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20260821/#delete-resource> ;
    touchstone:summary "Non-recursive DELETE of a non-empty container is rejected with 409; recursive deletion is requested via Depth: infinity." ;
    touchstone:clauseText """For container resources, the server defaults to non-recursive deletion. If the container is not empty and recursion is not requested, the server MUST reject the request with 409 Conflict. Servers MAY support recursive deletion of all contained resources within the container that is being deleted. Clients MUST use the Depth: infinity header to request for a recursive delete, as defined in [RFC4918].""" ;
    touchstone:clauseHash "sha256-01c0a1b64ea5a4fadb47e80e7e15af331f60b1553cf77a023e1499ce363432d9" ;
    touchstone:status touchstone:Approved ;
    dcterms:created "2026-07-16"^^xsd:date .

req:delete-updates-parent-listing-etag
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#delete-resource> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20260821/#delete-resource> ;
    touchstone:summary "Deleting a resource atomically removes it from the parent listing and refreshes the parent ETag (totalItems SHOULD update)." ;
    touchstone:clauseText """Deletion and Containment: When a resource is deleted, the server MUST atomically remove it from its parent container's items list. The parent container's totalItems count SHOULD be updated accordingly, and its ETag MUST be updated to reflect the change.""" ;
    touchstone:clauseHash "sha256-df7569f68fe1a57f99730d067346072ce8f987adc11b35a8eb91217932f3990a" ;
    touchstone:status touchstone:Approved ;
    dcterms:created "2026-07-16"^^xsd:date .

## ---- Containers ---------------------------------------------------------------

req:container-empty-items-array
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#container-properties> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20260821/#container-properties> ;
    touchstone:summary "A container representation's items is an array of contained-resource descriptions; an empty container yields an empty array." ;
    touchstone:clauseText """items: An array of contained resource descriptions (see below). If the container is empty, this MUST be an empty array. When the container listing is paginated, items contains only the current page of resources; see Pagination for details.""" ;
    touchstone:clauseHash "sha256-e44a4b6cb04567837ed30c6dc6d1e70221814dfb0c90d227536480934bfb2718" ;
    touchstone:status touchstone:Approved ;
    dcterms:created "2026-07-16"^^xsd:date .

req:contained-resource-type-values
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#contained-resource-description> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20260821/#contained-resource-description> ;
    touchstone:summary "A contained resource description's type is DataResource or Container (or an array containing at least one of the two)." ;
    touchstone:clauseText """type: The type of the resource. MUST be "DataResource" or "Container", or an array containing at least one of these two strings. Servers MAY include additional user-defined types as URIs (e.g., ["DataResource", "http://example.org/customType"]).""" ;
    touchstone:clauseHash "sha256-b5fd49783e768f0c96a31fb4e98724863aad5eb92a041c514bb2833a56f5baf9" ;
    touchstone:status touchstone:Approved ;
    dcterms:created "2026-07-16"^^xsd:date .

