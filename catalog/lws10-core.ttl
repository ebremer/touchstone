## ---- authentication ----

req:authn-credential-tamper-evident-claims
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#authentication-data-model> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20260821/#authentication-data-model> ;
    touchstone:summary "An authentication credential includes tamper-evident claims about a subject." ;
    touchstone:clauseText """An authentication credential MUST include tamper evident claims about a subject, including:""" ;
    touchstone:clauseHash "sha256-66ffa4466420e7c3de52bed930ddbd821effb33e29fb28451713e65a979aa36d" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:authn-subject-claim-uri
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#authentication-data-model> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20260821/#authentication-data-model> ;
    touchstone:summary "The subject claim is required and its value is a URI." ;
    touchstone:clauseText """subject REQUIRED — an identifier for an end user. This MUST be a URI.""" ;
    touchstone:clauseHash "sha256-b58f022a7abe74979bf7484f8c205501a673c3fd5de30bfc750742396a794ffe" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

