req:access-jsonld-context-lws-v1
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#json-ld-serialization> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20260821/#json-ld-serialization> ;
    touchstone:summary "Access request/grant JSON-LD documents include an @context ordered set containing https://www.w3.org/ns/lws/v1; extension contexts are allowed." ;
    touchstone:clauseText """This specification defines a JSON-LD serialization for access requests and access grants. Documents using this serialization MUST include an @context property whose value is an ordered set that includes https://www.w3.org/ns/lws/v1. Additional context entries MAY be included to define extension terms.""" ;
    touchstone:clauseHash "sha256-94eef7911655698e423ff897b247016c37fd9ba121dd234cecd0330a44474362" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:access-endpoints-are-lws-containers
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#access-protocol> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20260821/#access-protocol> ;
    touchstone:summary "Access request and grant endpoints are LWS containers conforming to this specification." ;
    touchstone:clauseText """The access request and access grant endpoints are LWS containers and MUST conform to the rules defined in this specification.""" ;
    touchstone:clauseHash "sha256-03eaf18110ecc3f704ca6b07b354921192ba1acd8be0499ae45fdfa433c74fe4" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:access-endpoints-get-post-delete
    a touchstone:Requirement ;
    touchstone:level "SHOULD" ;
    touchstone:specModule "lws10-core" ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#access-protocol> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20260821/#access-protocol> ;
    touchstone:summary "Access endpoints minimally support GET and POST; DELETE is recommended; other operations may be supported." ;
    touchstone:clauseText """These endpoints minimally require support for GET and POST operations. The DELETE operation is RECOMMENDED. Other operations MAY be supported.""" ;
    touchstone:clauseHash "sha256-10471356fc7d859d2d31b5ee98978b79a4473934ed37ec52adba0d5ca02d93cf" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:access-endpoints-jsonld-payloads
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#access-protocol> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20260821/#access-protocol> ;
    touchstone:summary "Access request and grant endpoints support the JSON-LD serialization for request and response payloads; other serializations are optional." ;
    touchstone:clauseText """These endpoints MUST support the JSON-LD serialization defined in 11.4.1 JSON-LD Serialization for both request and response payloads. Servers MAY support additional serializations.""" ;
    touchstone:clauseHash "sha256-6d0c24f2336a6bd971fafb35f802ea3466a36550d2a208568d7e49259362cbcc" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:access-post-location-header
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#access-protocol> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20260821/#access-protocol> ;
    touchstone:summary "A successful POST to an access endpoint responds with a Location header for the new resource." ;
    touchstone:clauseText """A successful POST operation MUST respond with a Location header set to the URL of the new resource.""" ;
    touchstone:clauseHash "sha256-2c125975acd0a0e7275ebbe6f49eadaf174d7ab7c8a2382ab20c11307c12574b" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:access-inbox-notifications
    a touchstone:Requirement ;
    touchstone:level "SHOULD" ;
    touchstone:specModule "lws10-core" ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#access-notifications> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20260821/#access-notifications> ;
    touchstone:summary "When an inbox property is present, the server should deliver notifications to that endpoint." ;
    touchstone:clauseText """Notifications provide a mechanism for informing agents and storage controllers about changes to access requests and access grants. When an inbox property is present on an access request or access grant, the server SHOULD deliver notifications to that endpoint, informing an assignee of the event.""" ;
    touchstone:clauseHash "sha256-d9dcec79c2781d33ca2d0920b2ece13cfa5d19169e29ede57696299f2aee02ca" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:access-notification-data-model
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#access-notifications> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20260821/#access-notifications> ;
    touchstone:summary "Notification serialization conforms to the LWS notification data model." ;
    touchstone:clauseText """The serialization of notifications MUST conform to the requirements of the LWS notification data model.""" ;
    touchstone:clauseHash "sha256-2ec22d13a8a478f44d82ff9a390b1b03ae33245f14054470cf907add8191a541" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:access-notification-delivery
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#access-notifications> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20260821/#access-notifications> ;
    touchstone:summary "Inbox notifications conform to the LWS notification delivery requirements." ;
    touchstone:clauseText """Notifications delivered to an inbox endpoint MUST conform to the requirements defined in the LWS protocol for notification delivery.""" ;
    touchstone:clauseHash "sha256-478f652a77485a7556ae5e38da3f283eb24dbfb1d11623382e337f0fdcd59a4f" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:access-notification-events
    a touchstone:Requirement ;
    touchstone:level "SHOULD" ;
    touchstone:specModule "lws10-core" ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#access-notification-events> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20260821/#access-notification-events> ;
    touchstone:summary "Servers should send notifications for the defined access lifecycle events." ;
    touchstone:clauseText """A server SHOULD send notifications in response to the following events:""" ;
    touchstone:clauseHash "sha256-0801528a59a92d781ce9f201d55ddc42b077cf57f6a1d905d8782f1a0d02c0ea" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:access-notify-request-created
    a touchstone:Requirement ;
    touchstone:level "SHOULD" ;
    touchstone:specModule "lws10-core" ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#access-notification-events> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20260821/#access-notification-events> ;
    touchstone:summary "The storage controller should be notified when a new access request is submitted." ;
    touchstone:clauseText """Access Request creation: When a new access request is submitted, the storage controller SHOULD be notified.""" ;
    touchstone:clauseHash "sha256-20186924d2f27560d41f30c434ebb854be9c0e7d829c65a1590ad8375eba7a0a" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:access-notify-grant-created
    a touchstone:Requirement ;
    touchstone:level "SHOULD" ;
    touchstone:specModule "lws10-core" ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#access-notification-events> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20260821/#access-notification-events> ;
    touchstone:summary "The requesting agent should be notified at the access-request inbox when a grant is created." ;
    touchstone:clauseText """Access Grant creation: When a new access grant is created, the requesting agent SHOULD be notified at the inbox specified in the associated access request.""" ;
    touchstone:clauseHash "sha256-e2d3eeef8a1489eb4484224c0da8d2a8829d4b638928e88aab6feae27e2fb958" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:access-notify-other-events
    a touchstone:Requirement ;
    touchstone:level "MAY" ;
    touchstone:specModule "lws10-core" ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#access-notification-events> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20260821/#access-notification-events> ;
    touchstone:summary "Servers may send notifications for other events." ;
    touchstone:clauseText """A server MAY send notifications in response to other events.""" ;
    touchstone:clauseHash "sha256-24212a64dca7a872097930fab668df3d8304539054dfe90b7d6560f772002738" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

## ---- lws-media-type ----

req:lws-cid-media-type-storage-description
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#lws-media-type-0> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20260821/#lws-media-type-0> ;
    touchstone:summary "A storage description is serializable as application/lws+cid, a specialization of a W3C Controlled Identifier document extended with the LWS vocabulary." ;
    touchstone:clauseText """An LWS storage description MUST be serializable with the media type application/lws+cid. The application/lws+cid media type identifies a document that is a specialization of a W3C Controlled Identifier document [CID-1.0], extended with the LWS vocabulary.""" ;
    touchstone:clauseHash "sha256-5cacfdb96040fabb8d08b7ce53dbc50badcdb84fd97dce33b2e2282f371c5507" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:lws-json-media-type-container-representation
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#lws-media-type-0> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20260821/#lws-media-type-0> ;
    touchstone:summary "A container representation supports the media type application/lws+json." ;
    touchstone:clauseText """An LWS container representation MUST support the media type application/lws+json.""" ;
    touchstone:clauseHash "sha256-6f63c9b04d66562a67197a183afbf3ddce851a3bc3e918e069d5b562c5a44dae" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:lws-profile-equivalence
    a touchstone:Requirement ;
    touchstone:level "SHOULD" ;
    touchstone:specModule "lws10-core" ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#lws-media-type-0> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20260821/#lws-media-type-0> ;
    touchstone:summary "application/ld+json with the lws/v1 profile should be treated as equivalent to application/lws+json." ;
    touchstone:clauseText """While LWS container representations use JSON-LD conventions, the constraints and requirements for LWS justify the use of a specific media type. Because LWS containers can be considered a restricted profile of JSON-LD, implementations SHOULD consider the application/ld+json; profile="https://www.w3.org/ns/lws/v1" media type as equivalent to application/lws+json.""" ;
    touchstone:clauseHash "sha256-6c5bd4cbf7990bb114d7f1505b4d106c7ccde97d5da729eca2f1b45f822b78f8" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:conneg-vary-accept
    a touchstone:Requirement ;
    touchstone:level "SHOULD" ;
    touchstone:specModule "lws10-core" ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#media-type-equivalence> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20260821/#media-type-equivalence> ;
    touchstone:summary "Container responses should carry Vary: Accept, since their Content-Type depends on the request Accept header." ;
    touchstone:clauseText """Because the Content-Type of a container response depends on the request's Accept header, these responses SHOULD include a Vary: Accept header [RFC9110].""" ;
    touchstone:clauseHash "sha256-35b6ee972d4f136b9ca2aadae32c8de0145dd5fa6e14917c7f27ff3530596d9d" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:pagination-over-threshold
    a touchstone:Requirement ;
    touchstone:level "SHOULD" ;
    touchstone:specModule "lws10-core" ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#pagination> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20260821/#pagination> ;
    touchstone:summary "Servers should paginate containers whose membership exceeds a server-determined threshold." ;
    touchstone:clauseText """Certain composite resources, like containers, may hold a large number of resources. To allow clients to retrieve listings incrementally, servers SHOULD support pagination for containers whose membership exceeds a server-determined threshold.""" ;
    touchstone:clauseHash "sha256-a02c47a98323bcce343f87dd90f5f76f26473d82ff238fec3c309194a8ab77b6" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:pagination-link-first
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#pagination-link-relations> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20260821/#pagination-link-relations> ;
    touchstone:summary "rel=first is present on paginated responses." ;
    touchstone:clauseText """rel="first": The URI of the first page of results. MUST be present on paginated responses.""" ;
    touchstone:clauseHash "sha256-d643ed04cd55c3b95f9330a6a80bc5f9f1e37983c902c5a8c82be4cab23e9971" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:pagination-link-last
    a touchstone:Requirement ;
    touchstone:level "MAY" ;
    touchstone:specModule "lws10-core" ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#pagination-link-relations> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20260821/#pagination-link-relations> ;
    touchstone:summary "rel=last may be present on paginated responses." ;
    touchstone:clauseText """rel="last": The URI of the last page of results. MAY be present on paginated responses.""" ;
    touchstone:clauseHash "sha256-b6637a003fdc09059371d3a0244b010edad567a7f2af782edfd3025a2227dcbd" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:pagination-link-next
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#pagination-link-relations> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20260821/#pagination-link-relations> ;
    touchstone:summary "rel=next is present when subsequent pages exist and omitted on the last page." ;
    touchstone:clauseText """rel="next": The URI of the next page of results. MUST be present when there are subsequent pages. MUST be omitted on the last page.""" ;
    touchstone:clauseHash "sha256-d1f84087ab812fa651d624bb40384d64906c15dfc9d8d3d51a754a95d0d7040d" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:pagination-link-prev
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#pagination-link-relations> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20260821/#pagination-link-relations> ;
    touchstone:summary "rel=prev may be present with preceding pages and is omitted on the first page." ;
    touchstone:clauseText """rel="prev": The URI of the previous page of results. MAY be present when there are preceding pages. MUST be omitted on the first page.""" ;
    touchstone:clauseHash "sha256-432a6554a32a19bd70bc4ca020d2c5589e246a35b9018d55c340389870db4480" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:pagination-uris-opaque
    a touchstone:Requirement ;
    touchstone:level "SHOULD" ;
    touchstone:specModule "lws10-core" ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#pagination-link-relations> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20260821/#pagination-link-relations> ;
    touchstone:summary "Pagination URIs are opaque; clients use the URIs the server provides." ;
    touchstone:clauseText """All pagination URIs are opaque to the client. Clients SHOULD NOT construct or modify pagination URIs; they SHOULD use the URIs provided by the server.""" ;
    touchstone:clauseHash "sha256-de735826ff9e965758a137dd925a033c972bf0301c95b073a08c4fce6fb01bf8" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:pagination-first-page-flow
    a touchstone:Requirement ;
    touchstone:level "MAY" ;
    touchstone:specModule "lws10-core" ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#requesting-pages> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20260821/#requesting-pages> ;
    touchstone:summary "The composite resource URI yields the first page; servers may support direct access to specific pages." ;
    touchstone:clauseText """A client requests the composite resource's URI to obtain the first page. The response includes pagination Link headers that the client follows to retrieve subsequent pages. Servers MAY also support direct access to specific pages via the pagination URIs obtained during a previous scan.""" ;
    touchstone:clauseHash "sha256-9a3c77a5b810d351969a204a13e331b4bd18782dfd1a88034ad06952bdb44329" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:pagination-200-totalitems-all-pages
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#requesting-pages> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20260821/#requesting-pages> ;
    touchstone:summary "Paginated responses are 200 OK; totalItems should reflect the total across all pages." ;
    touchstone:clauseText """When a paginated response is returned, the server MUST respond with 200 OK. The totalItems property in the response body SHOULD reflect the total number of items across all pages, not just the current page.""" ;
    touchstone:clauseHash "sha256-7eb7a9699638ebd5189c4432a593be3151b935471f0b53f486e16cbb85df4506" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

## ---- security-considerations ----

req:security-notification-access-control
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#security-notifications> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20260821/#security-notifications> ;
    touchstone:summary "Access control on subscriptions and on notification delivery is consistent with access control on the underlying resources." ;
    touchstone:clauseText """Information Disclosure: Notifications may reveal the existence or modification patterns of resources. Access control on subscriptions and on individual notification delivery MUST be consistent with access control on the underlying resources.""" ;
    touchstone:clauseHash "sha256-c991782fbf958dfe7529ecd74c7f3808b6a444e5de5f1a61d3b4b1deca9b28aa" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

## ---- privacy-considerations ----

req:privacy-notification-authorized-resources-only
    a touchstone:Requirement ;
    touchstone:level "SHOULD" ;
    touchstone:specModule "lws10-core" ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#privacy-notifications> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20260821/#privacy-notifications> ;
    touchstone:summary "Subscribers should only receive notifications for resources they are authorized to access." ;
    touchstone:clauseText """Activity Tracking: Notifications inherently reveal when resources change. Subscribers SHOULD only receive notifications for resources they are authorized to access.""" ;
    touchstone:clauseHash "sha256-ff96b5fc77b4511e38cfea6c267262eff4bfb7e36837c0d9b897da97fb6e64f5" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:privacy-notification-actor-omitted
    a touchstone:Requirement ;
    touchstone:level "SHOULD" ;
    touchstone:specModule "lws10-core" ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#privacy-notifications> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20260821/#privacy-notifications> ;
    touchstone:summary "The actor property should be omitted by default; servers may make its inclusion configurable." ;
    touchstone:clauseText """Actor Disclosure: Including the actor property in notifications reveals who made changes. This may be inappropriate in some contexts. The actor property SHOULD be omitted by default. Servers MAY make its inclusion configurable.""" ;
    touchstone:clauseHash "sha256-e96630008a195228659a9dc8c872629221f0a56d828693da0512c7d7be9ac894" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

## ---- iana-considerations ----

req:iana-ld-json-profile-equivalence
    a touchstone:Requirement ;
    touchstone:level "SHOULD" ;
    touchstone:specModule "lws10-core" ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#iana-media-type-registry> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20260821/#iana-media-type-registry> ;
    touchstone:summary "Per the IANA registration, application/ld+json with the lws/v1 profile should be treated as equivalent to application/lws+json." ;
    touchstone:clauseText """Because LWS containers can be considered a restricted profile of JSON-LD, implementations SHOULD consider the application/ld+json; profile="https://www.w3.org/ns/lws/v1" media type as equivalent to application/lws+json.""" ;
    touchstone:clauseHash "sha256-31cb4ba424a8bfe01ba0b4ded0fbdedcf174b44af179ff3fcf987321784d73e8" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .
