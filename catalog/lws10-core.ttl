    touchstone:summary "An authentication credential includes tamper-evident claims about a subject." ;
    touchstone:clauseText """An authentication credential MUST include tamper evident claims about a subject, including:""" ;
    touchstone:clauseHash "sha256-66ffa4466420e7c3de52bed930ddbd821effb33e29fb28451713e65a979aa36d" ;
    touchstone:status touchstone:Draft ;
