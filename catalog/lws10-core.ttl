req:authz-401-www-authenticate-challenge
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#authorization-server-discovery> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#authorization-server-discovery> ;
    touchstone:summary "A storage server generating a 401 sends a WWW-Authenticate header with at least one conforming challenge, which carries the RFC 9728 resource_metadata parameter: the URL of the protected resource metadata document for the requested resource." ;
    touchstone:clauseText """A storage server generating a 401 (Unauthorized) response MUST send a WWW-Authenticate header field containing at least one conforming challenge. A conforming challenge MUST include the resource_metadata parameter defined in Section 5.1 of [RFC9728], whose value is the URL of the protected resource metadata document for the requested resource.""" ;
    touchstone:clauseHash "sha256-3e01211d24f10bef2bf1c44d87ca454f24629c6516be2be6e128b7f5aa472bba" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:authz-401-storage-link
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#authorization-server-discovery> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#authorization-server-discovery> ;
    touchstone:summary "A 401 response also carries a Link header identifying the storage that contains the requested resource; the client sends that URI as the token request's resource." ;
    touchstone:clauseText """The response MUST also include a Link header identifying the storage that contains the requested resource, as described in 6.1.2 Discovery and Binding. A client supplies this URI as the resource parameter when requesting an access token, as described in 5.2.5.1 Request.""" ;
    touchstone:clauseHash "sha256-0ca414fae637e1659e63861f84c7dc81b3cc883011ad1e12acf66f1d8c68327d" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-10-19"^^xsd:date .

req:authz-challenge-extra-params
    a touchstone:Requirement ;
    touchstone:level "MAY" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#authorization-server-discovery> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#authorization-server-discovery> ;
    touchstone:summary "Challenges may include other headers and parameters." ;
    touchstone:clauseText """Other headers and parameters MAY be included.""" ;
    touchstone:clauseHash "sha256-fa5d67a01af3e710b5c5b3ba3211376e00287b4099efc28ecaba546ce0f79d14" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:authz-prm-conforms-rfc9728
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#protected-resource-metadata> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#protected-resource-metadata> ;
    touchstone:summary "A protected resource metadata document conforms to OAuth 2.0 Protected Resource Metadata (RFC 9728)." ;
    touchstone:clauseText """A protected resource metadata document describes how a client can obtain an access token for a resource. It MUST conform to OAuth 2.0 Protected Resource Metadata [RFC9728].""" ;
    touchstone:clauseHash "sha256-1cc13a8f61b59e686682d30768919028b9a5d06bbbee2a52c96c47d3bdcae1b3" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-10-19"^^xsd:date .

req:authz-prm-authorization-servers
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#protected-resource-metadata> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#protected-resource-metadata> ;
    touchstone:summary "A protected resource metadata document must carry authorization_servers, naming the issuer identifier of at least one authorization server." ;
    touchstone:clauseText """This specification extends [RFC9728] as follows: the authorization_servers parameter is REQUIRED in a protected resource metadata document, and its value MUST contain the issuer identifier of at least one authorization server.""" ;
    touchstone:clauseHash "sha256-6d7572bb252ecfdbd477b1f27054b1bebdb93de8f8553ca8d6788be7b09d8eb7" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-10-19"^^xsd:date .

req:authz-client-discovery-validation
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Client ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#authorization-discovery-validation> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#authorization-discovery-validation> ;
    touchstone:summary "Before requesting an access token a client performs the discovery checks against the requested URI, and does not use the discovered values if any check fails." ;
    touchstone:clauseText """The values a client uses to obtain an access token are supplied by the storage server in a 401 (Unauthorized) response. Before requesting an access token, a client MUST perform the following checks, each of which compares a discovered value against the requested URI that produced the 401 response. If any check fails, the client MUST NOT use the discovered values to request an access token.""" ;
    touchstone:clauseHash "sha256-f76cc61eaffcdf5b3f147fe6b1f49a4dd3e01b169dec3820a7082bb347dec739" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-10-19"^^xsd:date .

req:authz-client-resource-metadata-same-origin
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Client, touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#authorization-discovery-validation> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#authorization-discovery-validation> ;
    touchstone:summary "The resource_metadata URL has the same scheme and authority as the requested URI." ;
    touchstone:clauseText """The resource_metadata URL MUST have the same scheme and authority as the requested URI.""" ;
    touchstone:clauseHash "sha256-9a7c99d3c349fa5f209bfddad411f4df6fd45ac0e74bc059e34f81a146c9a7f2" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-10-19"^^xsd:date .

req:authz-client-prm-resource-matches
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Client, touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#authorization-discovery-validation> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#authorization-discovery-validation> ;
    touchstone:summary "The resource value of the protected resource metadata document is identical to the requested URI (RFC 9728 section 3.3)." ;
    touchstone:clauseText """The resource value of the protected resource metadata document MUST be identical to the requested URI, as required by Section 3.3 of [RFC9728].""" ;
    touchstone:clauseHash "sha256-4f4717e1fa03a1372805d501724554e33a6ab5fef298fe613dd95ddfede07e43" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-10-19"^^xsd:date .

req:authz-client-storage-root-same-origin
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Client, touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#authorization-discovery-validation> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#authorization-discovery-validation> ;
    touchstone:summary "The client obtains the storage description of the storage the Link header names, whose StorageRoot serviceEndpoint has the same scheme and authority as the requested URI." ;
    touchstone:clauseText """The client MUST obtain the storage description of the storage identified by the Link header, and the serviceEndpoint of its StorageRoot service MUST have the same scheme and authority as the requested URI.""" ;
    touchstone:clauseHash "sha256-9b697c7a604cdf7167e683102b1ae45918995ef42f12b81824ee8b7c6056dad3" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-10-19"^^xsd:date .

req:authz-server-metadata-well-known
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:AuthorizationServer ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#authorization-server-metadata> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#authorization-server-metadata> ;
    touchstone:summary "Authorization servers provide RFC 8414 metadata at /.well-known/lws-configuration." ;
    touchstone:clauseText """An authorization server MUST provide a metadata resource to allow clients to discover endpoint locations and capabilities as described in [RFC8414]. This metadata resource MUST be available at a URL with the path /.well-known/lws-configuration.""" ;
    touchstone:clauseHash "sha256-f9ebaec7e18a5113118538d069b5d966ece2d236e96230714f42bd19e5c91bb1" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:authz-metadata-subject-token-types
    a touchstone:Requirement ;
    touchstone:level "SHOULD" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:AuthorizationServer ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#authorization-server-metadata> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#authorization-server-metadata> ;
    touchstone:summary "An authorization server SHOULD advertise the subject token types its token endpoint accepts via subject_token_types_supported in its metadata." ;
    touchstone:clauseText """subject_token_types_supported OPTIONAL. JSON array containing a list of valid subject_token_type values that can be supplied at the authorization server's token endpoint. An authorization server SHOULD advertise the subject tokens that it supports by including this entry in the server metadata document.""" ;
    touchstone:clauseHash "sha256-7ead1dc159ef7becb9f677e311b6426efbcb90beef857b43c7ee66746480564d" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-30"^^xsd:date .

req:authz-metadata-subject-identifier-types
    a touchstone:Requirement ;
    touchstone:level "SHOULD" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:AuthorizationServer ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#authorization-server-metadata> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#authorization-server-metadata> ;
    touchstone:summary "An authorization server SHOULD advertise the subject identifier types it supports (URI schemes, or did: plus method) via subject_identifier_types_supported; omitted means [https]." ;
    touchstone:clauseText """subject_identifier_types_supported OPTIONAL. JSON array containing a list of subject identifier types that the authorization server supports. Each value is a URI starting with its scheme such as "https:", or, for Decentralized Identifiers, "did:" followed by the DID method name (e.g., "did:web", "did:key"). An authorization server SHOULD advertise the subject identifier types that it supports by including this entry in the server metadata document. If omitted, the default value is ["https"].""" ;
    touchstone:clauseHash "sha256-ef8878d1d668b823cbffec8aff5602d6804ef4684166aac91bc715b6e3ef27aa" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-30"^^xsd:date .

req:authz-token-exchange-grant
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:AuthorizationServer ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#authorization-token-exchange-request> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#authorization-token-exchange-request> ;
    touchstone:summary "The token endpoint supports the RFC 8693 token-exchange grant type." ;
    touchstone:clauseText """The authorization server's token endpoint MUST support the urn:ietf:params:oauth:grant-type:token-exchange grant type, as described in OAuth 2.0 Token Exchange [RFC8693].""" ;
    touchstone:clauseHash "sha256-3db76f57046d461b36c96bf1ef31ac2f5104d98036e2e9316df059c6bae169ad" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:authz-token-exchange-resource-param
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:AuthorizationServer, touchstone:Client ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#authorization-token-exchange-request> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#authorization-token-exchange-request> ;
    touchstone:summary "The resource parameter is a required URI that populates aud, and is the URI of the storage that contains the requested resource, as the 401's Link header gave it; requests naming unknown or untrusted storages are rejected." ;
    touchstone:clauseText """The resource parameter is REQUIRED. The value of this parameter MUST be a URI and will be used to populate the aud (audience) claim in the resulting access token. The supplied value MUST be the URI of the storage that contains the requested resource, as provided in the Link header of an unauthorized response. The authorization server MUST reject any request in which the resource parameter identifies an unknown or untrusted storage.""" ;
    touchstone:clauseHash "sha256-110a85b4912afd3018c6f0b819d2ee6e5e4a5214ba4ab43352ce23f4a680ddaf" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:authz-token-exchange-subject-token-param
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:AuthorizationServer, touchstone:Client ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#authorization-token-exchange-request> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#authorization-token-exchange-request> ;
    touchstone:summary "The subject_token parameter is required and carries a valid subject token such as an authentication credential." ;
    touchstone:clauseText """The subject_token parameter is REQUIRED. The value of this parameter MUST include a valid subject token, such as an authentication credential.""" ;
    touchstone:clauseHash "sha256-c119aa875ac2e82b96be12aeef7ae3734c298c1636eebfe8792f88c54ed4b31d" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:authz-validate-before-issuing
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:AuthorizationServer ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#authorization-token-exchange-request> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#authorization-token-exchange-request> ;
    touchstone:summary "All presented tokens are validated before an access token is returned." ;
    touchstone:clauseText """Before returning an access token to the client, the authorization server MUST successfully validate all presented tokens.""" ;
    touchstone:clauseHash "sha256-7bb8a97c7e63e88af3028f68413198949b2b246701238c6602d1c2334ae7c5f6" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:authz-token-response-rfc6749-rfc9068
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:AuthorizationServer ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#authorization-token-exchange-response> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#authorization-token-exchange-response> ;
    touchstone:summary "Token responses conform to RFC 6749 section 5.1; access tokens conform to RFC 9068." ;
    touchstone:clauseText """If the token request is valid and the client is authorized to make the request, the authorization server response MUST conform to Section 5.1 from the OAuth 2.0 Authorization Framework [RFC6749]. The resulting access token MUST conform to the JSON Web Token Profile for OAuth 2.0 Access Tokens [RFC9068].""" ;
    touchstone:clauseHash "sha256-83d70d709d04471fb9d469c56944cb1214b7bffe8ddf59c3b80a980bb895cedd" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:authz-access-token-sub-claim
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:AuthorizationServer ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#authorization-token-exchange-response> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#authorization-token-exchange-response> ;
    touchstone:summary "The access token sub claim is a required URI identifying the acting agent." ;
    touchstone:clauseText """sub (subject) — REQUIRED. This claim MUST be a URI identifying the agent performing the operation""" ;
    touchstone:clauseHash "sha256-a54d5770a6591abaa0cfd5f63601a5ebedfe6bd23e62479bcdb0df480e6792f7" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:authz-access-token-iss-claim
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:AuthorizationServer ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#authorization-token-exchange-response> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#authorization-token-exchange-response> ;
    touchstone:summary "The access token iss claim is required and is the authorization server URI." ;
    touchstone:clauseText """iss (issuer) — REQUIRED. This claim MUST be the URI of the authorization server""" ;
    touchstone:clauseHash "sha256-47b05c0e176f9dbfa1f4925995d8ac449170f19c2d01ec9a66fb2340bec5e19f" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:authz-access-token-client-id-claim
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:AuthorizationServer ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#authorization-token-exchange-response> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#authorization-token-exchange-response> ;
    touchstone:summary "The access token client_id claim is a required URI identifying the client." ;
    touchstone:clauseText """client_id (client id) — REQUIRED. This claim MUST be a URI identifying the client.""" ;
    touchstone:clauseHash "sha256-119fe51a855774b26328e6e8480bfec6a9b32f393d7b83a754c3337b8fb352f9" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:authz-access-token-aud-claim
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:AuthorizationServer ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#authorization-token-exchange-response> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#authorization-token-exchange-response> ;
    touchstone:summary "The access token aud claim includes the resource-parameter URI, which is a storage URI." ;
    touchstone:clauseText """aud (audience) — REQUIRED. This claim MUST include the URI supplied by the client in the resource parameter, which is the URI of a storage. This value will be used to restrict the entities for which the access token is valid.""" ;
    touchstone:clauseHash "sha256-361b128093405a71ed22c8827ccef485b052726b4ed743f93a1c2f9d55b8c3ab" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:authz-access-token-exp-short-lived
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:AuthorizationServer ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#authorization-token-exchange-response> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#authorization-token-exchange-response> ;
    touchstone:summary "The exp claim is required; short lifetimes are recommended (300 seconds or less)." ;
    touchstone:clauseText """exp (expiration) — REQUIRED. Authorization servers SHOULD issue tokens with short lifetimes (RECOMMENDED: 300 seconds or less) to limit exposure from token theft.""" ;
    touchstone:clauseHash "sha256-fe15092ec3b2b65fba887bc8453d1933c45e8dfa08eee866429dd141f14faa15" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:authz-access-token-iat-claim
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:AuthorizationServer ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#authorization-token-exchange-response> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#authorization-token-exchange-response> ;
    touchstone:summary "The iat claim is required." ;
    touchstone:clauseText """iat (issued at) — REQUIRED.""" ;
    touchstone:clauseHash "sha256-8c797b8e8ff298bdba9f28aeb865f2bab3df292701d596e0874a9b733a61c631" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:authz-access-token-jti-claim
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:AuthorizationServer ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#authorization-token-exchange-response> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#authorization-token-exchange-response> ;
    touchstone:summary "The jti claim is required." ;
    touchstone:clauseText """jti (JWT ID) — REQUIRED.""" ;
    touchstone:clauseHash "sha256-5b60b20f42dfd977aa4cd79cbc3f749b96516481f5b5892e1e7e60c4bb2d9e16" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:authz-token-error-rfc6749
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:AuthorizationServer ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#authorization-token-exchange-response> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#authorization-token-exchange-response> ;
    touchstone:summary "Invalid or unauthorized token requests produce RFC 6749 section 5.2 error responses." ;
    touchstone:clauseText """All invalid or unauthorized requests MUST result in an error response as described in Section 5.2 in the OAuth 2.0 Authorization Framework [RFC6749].""" ;
    touchstone:clauseHash "sha256-89f42de4674d4c1d14029f84f7153e20fa424d072f9ff46a29fc2a0535696300" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:authz-bearer-presentation-rfc6750
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Client ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#authorization-token-validation-presentation> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#authorization-token-validation-presentation> ;
    touchstone:summary "Clients present access tokens via the Authorization header per RFC 6750." ;
    touchstone:clauseText """A client MUST present an access token to a storage server using the Authorization header with an authentication scheme as defined in [RFC6750].""" ;
    touchstone:clauseHash "sha256-37b84bf07e9da4de9803ac279d25add6b35bed1f6d1184d5504125962066d07d" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:authz-token-validation-checklist
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#authorization-token-validation-verification> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#authorization-token-validation-verification> ;
    touchstone:summary "Storage servers validate access tokens with the defined checks, rejecting the request on any failure." ;
    touchstone:clauseText """A storage server MUST validate an access token by performing the following checks, rejecting the request upon any failure:""" ;
    touchstone:clauseHash "sha256-5ab2749bfd3917b5e9bbf94c44513d7b350d8bf04586df7e56424ca114daf552" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:authz-jwt-signature-jwks-rotation
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#authorization-token-validation-verification> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#authorization-token-validation-verification> ;
    touchstone:summary "JWT signatures are verified against the jwks_uri from server metadata; keys should be cached and key rotation is supported." ;
    touchstone:clauseText """JWT Signature Validation: Verify the JWT signature using the authorization server's public key retrieved from the jwks_uri specified in the authorization server metadata. Storage servers SHOULD cache these keys and MUST support key rotation.""" ;
    touchstone:clauseHash "sha256-a8dc12c0c387baabbad4a71081fe286667e15e38878522592734d6162cff55b5" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:authz-invalid-token-401-error-param
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#authorization-token-validation-verification> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#authorization-token-validation-verification> ;
    touchstone:summary "Failed validation yields 401 with a WWW-Authenticate header carrying resource_metadata and an error parameter such as invalid_token." ;
    touchstone:clauseText """If validation fails, the storage server MUST return 401 Unauthorized with a WWW-Authenticate header containing the resource_metadata parameter and an appropriate error parameter (e.g., invalid_token, invalid_request, or insufficient_scope).""" ;
    touchstone:clauseHash "sha256-9a14cfdd36d02fc0c41eb349fcd5edb104d742f4a0ef81bebe30d7fadf379891" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:authz-policy-denial-rejected
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#authorization-token-validation-verification> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#authorization-token-validation-verification> ;
    touchstone:summary "A valid token whose authorization policy disallows the operation is rejected." ;
    touchstone:clauseText """If the token is otherwise valid but an authorization policy does not allow the requested operation, the storage server MUST reject the request.""" ;
    touchstone:clauseHash "sha256-8549fd4218f9771f81b63bdf6e208f563184f02a9fc87a8b29252b094db14cb5" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

## ---- discovery ----

req:storage-description-id-required
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#storage-description-data-model> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#storage-description-data-model> ;
    touchstone:summary "The storage description id is REQUIRED and MUST be the canonical URI of the storage, which is also the canonical URL of its controlled identifier document." ;
    touchstone:clauseText """id - the id property is REQUIRED. Its value MUST be the canonical URI of the storage. Per [CID-1.0], this URI is also the canonical URL of the controlled identifier document.""" ;
    touchstone:clauseHash "sha256-8d62eba55219ff6303a9a0d9a70a25383b103814f999ab7c2328b99ed9c1c433" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:storage-description-type-storage
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#storage-description-data-model> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#storage-description-data-model> ;
    touchstone:summary "The storage description type equals or includes the string Storage (case-sensitive)." ;
    touchstone:clauseText """type - the type property is REQUIRED. Its value MUST be a string that equals Storage or a set of strings that contains an item equal to Storage (case-sensitive).""" ;
    touchstone:clauseHash "sha256-d34e96655162731052e94d2add6c23874bdb43f6b236af8b88d0a7e6a8249855" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:storage-capability-id-optional
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#storage-description-data-model> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#storage-description-data-model> ;
    touchstone:summary "A capability object id, if present, is a URI." ;
    touchstone:clauseText """id - the id property is OPTIONAL. If present, its value MUST be a URI.""" ;
    touchstone:clauseHash "sha256-38797dbe5fc75799e3b64ee6bb70487c88b411eb3fd3d3852e70c88bf96043d2" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:storage-capability-type-required
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#storage-description-data-model> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#storage-description-data-model> ;
    touchstone:summary "A capability object type is a required string or set of strings." ;
    touchstone:clauseText """type - the type property is REQUIRED. Its value MUST be a string or a set of strings.""" ;
    touchstone:clauseHash "sha256-fa570fdbd4543e7bc5fdd9f5658d07b51579e2d27f1220c296b3fa05fd8bd86e" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:storage-capability-property
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#storage-description-data-model> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#storage-description-data-model> ;
    touchstone:summary "The capability property, if present, is a set of capability maps; additional properties are allowed." ;
    touchstone:clauseText """capability - the capability property is OPTIONAL. Its value MUST be a set of capabilities, where each capability is described by a map containing the following properties. Additional properties MAY be present.""" ;
    touchstone:clauseHash "sha256-2ddce797173bf841a86df3599e0e1060139b1de597fff0496cfa34156ece9050" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:storage-service-id-optional
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#storage-description-data-model> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#storage-description-data-model> ;
    touchstone:summary "A service object id, if present, is a URI." ;
    touchstone:clauseText """id - the id property is OPTIONAL. If present, its value MUST be a URI.""" ;
    touchstone:clauseHash "sha256-38797dbe5fc75799e3b64ee6bb70487c88b411eb3fd3d3852e70c88bf96043d2" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:storage-service-type-required
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#storage-description-data-model> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#storage-description-data-model> ;
    touchstone:summary "A service object type is a required string or set of strings." ;
    touchstone:clauseText """type - the type property is REQUIRED. Its value MUST be a string or a set of strings.""" ;
    touchstone:clauseHash "sha256-fa570fdbd4543e7bc5fdd9f5658d07b51579e2d27f1220c296b3fa05fd8bd86e" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:storage-service-endpoint-required
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#storage-description-data-model> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#storage-description-data-model> ;
    touchstone:summary "A service object serviceEndpoint is a required URI." ;
    touchstone:clauseText """serviceEndpoint - the serviceEndpoint property is REQUIRED. Its value MUST be a URI.""" ;
    touchstone:clauseHash "sha256-81aaa3471b6838d89d2e5577a37b841589da46de59640238bbec44428f7fefc5" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:storage-service-property
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#storage-description-data-model> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#storage-description-data-model> ;
    touchstone:summary "The service property is a required set of service maps; additional properties are allowed." ;
    touchstone:clauseText """service - the service property is REQUIRED. Its value MUST be a set of services, where each service is described by a map containing the following properties. Additional properties MAY be present. The set MUST contain a service whose type equals StorageRoot.""" ;
    touchstone:clauseHash "sha256-2f53fdfb707476a1f41f2671201e817671a80c4f23b24618c63d24c78c797263" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:storage-description-link-header
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#storage-description-binding> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#storage-description-binding> ;
    touchstone:summary "GET/HEAD responses on storage resources include a Link header whose target is the canonical storage URI, with rel=https://www.w3.org/ns/lws#storage." ;
    touchstone:clauseText """All responses to GET and HEAD requests targeting storage resources MUST include a Link header whose target is the canonical URI of the storage, including a relation (rel) parameter whose value equals https://www.w3.org/ns/lws#storage.""" ;
    touchstone:clauseHash "sha256-d93adbe668ac96651f2a00feb1a30c250e7750b149d3dcbc7d69c98a55f6e653" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:storage-uri-returns-lws-cid-document
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#storage-description-binding> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#storage-description-binding> ;
    touchstone:summary "A request for the storage URI returns a storage description document with media type application/lws+cid unless content negotiation requires otherwise." ;
    touchstone:clauseText """Requests for the storage URI MUST return a document that conforms to the storage description resource data model with a media type of application/lws+cid, unless content negotiation requires a different format.""" ;
    touchstone:clauseHash "sha256-be2dba2cb331ac524ad68d758de7017e0c9ec61a9f366af78501deccb5e0c1e4" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:capability-move-resource
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server, touchstone:Client ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#storage-description-capabilities> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#storage-description-capabilities> ;
    touchstone:summary "A storage that lets clients change the up link of a Storage Resource describes a MoveResource capability; clients do not assume the up link is modifiable without it." ;
    touchstone:clauseText """A storage that allows clients to change the up link of a Storage Resource, and thereby to move resources between containers as described in 9.6 Moving resources between containers, MUST describe a capability whose type equals MoveResource. Clients MUST NOT assume that the up link is modifiable in the absence of this capability. The following properties are defined for a MoveResource capability:""" ;
    touchstone:clauseHash "sha256-9a64b6bbdfed9283bf989592010a514f168a44049bd2370700364251cf9d130a" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-10-19"^^xsd:date .

req:capability-move-applies-to
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server, touchstone:Client ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#storage-description-capabilities> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#storage-description-capabilities> ;
    touchstone:summary "The MoveResource appliesTo property is optional and, if present, a set of Storage Resource type names; absent, the capability covers data resources only." ;
    touchstone:clauseText """appliesTo - the appliesTo property is OPTIONAL. If present, its value MUST be a set of strings naming the types of Storage Resource the capability applies to, such as DataResource or Container. If the property is absent, the capability applies to data resources only.""" ;
    touchstone:clauseHash "sha256-1f5979815230efd37e2ff047cbe515fbd9dd474faaa8564dc7c0a4176bbdb11b" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-10-19"^^xsd:date .

req:capability-move-preserves-identifier
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server, touchstone:Client ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#storage-description-capabilities> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#storage-description-capabilities> ;
    touchstone:summary "The MoveResource preservesIdentifier property is optional and, if present, a boolean; absent, clients do not assume identifiers are preserved and rely on the update's response." ;
    touchstone:clauseText """preservesIdentifier - the preservesIdentifier property is OPTIONAL. If present, its value MUST be a boolean indicating whether the storage preserves the identifier of a moved resource. If the property is absent, clients MUST NOT assume that identifiers are preserved, and MUST rely on the response to the update to determine the identifier of the resource.""" ;
    touchstone:clauseHash "sha256-a80b059b2f42352b5112fea58bf96f6e1ff9367f337833e269b7146cb5b8812b" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-10-19"^^xsd:date .

req:storage-description-storageroot-service
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#storage-description-services> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#storage-description-services> ;
    touchstone:summary "A storage description contains a StorageRoot service whose serviceEndpoint is the URI of the storage root container." ;
    touchstone:clauseText """A storage description resource MUST contain a StorageRoot service whose serviceEndpoint is the URI of the storage root container. Additional services connected to a storage MAY also be present. The API definition of these additional services are outside the scope of this specification.""" ;
    touchstone:clauseHash "sha256-2c1b5cecf1ba769a9e51afb667839616f28d75812759ea5402d68a90abb57de6" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:storage-description-lws-cid
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#storage-description-representation> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#storage-description-representation> ;
    touchstone:summary "A storage description is serializable as application/lws+cid, and its @context is an array starting with the CID and LWS context URIs." ;
    touchstone:clauseText """A storage description MUST be serializable with the media type application/lws+cid. The @context property MUST be an array starting with the URIs https://www.w3.org/ns/cid/v1 and https://www.w3.org/ns/lws/v1. Other representations MAY be available via content negotiation.""" ;
    touchstone:clauseHash "sha256-0f6a741a5e80f8f6527e4df9a99655b7591c40695ba0c8b918653d3d62d9f511" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

## ---- logical-resource-organization ----

req:container-model-members
    a touchstone:Requirement ;
    touchstone:level "MAY" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#container-model> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#container-model> ;
    touchstone:summary "A container holds references to its members, which may be data resources or further containers; storage may itself act as the root container." ;
    touchstone:clauseText """Linked Web Storage organizes resources into containers. A container is a specialized resource that holds references to other resources, called its members. Containers serve as organizational units, analogous to directories or collections, enabling clients to group, discover, and navigate resources. A container maintains references to its member resources, which may comprise both non-container resources and additional container resources, thereby enabling hierarchical formations. Typically, a container holds minimal intrinsic content beyond metadata or enumerations of its members; its principal role is to aggregate and structure subordinate resources. The storage system's root is designated as a container, serving as the apex organizational unit devoid of a superior parent. The structure of container representations is defined in 8.1 Container Representation; their media type and pagination requirements are defined in 12. LWS Media Type. Storage MAY function as a root container, enabling direct writes.""" ;
    touchstone:clauseHash "sha256-390b0261b3fafd5511f90783408ba276426cf33b66d905a49025a36c3a91b6a7" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:containment-rel-up-get-head
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#containment> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#containment> ;
    touchstone:summary "Containment is expressed via a Link header rel=up on GET and HEAD responses of any non-root resource." ;
    touchstone:clauseText """The containment relationship between a resource and its parent container is expressed via the rel="up" link relation. Servers MUST include a Link header with rel="up" pointing to the parent container in responses to GET and HEAD requests on any non-root resource.""" ;
    touchstone:clauseHash "sha256-7a73d9bbecac74f599a78d31753269e33f32df2f1bd5ccf0f278beeb6d56d59f" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:containment-integrity
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#containment-integrity> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#containment-integrity> ;
    touchstone:summary "The server maintains containment integrity at all times." ;
    touchstone:clauseText """The server MUST maintain containment integrity at all times:""" ;
    touchstone:clauseHash "sha256-e29f525bf2ee11e1828b5133a25da8443f813ec90c2f0483356dbffb4dbb05c8" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:containment-create-atomic-items
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#containment-integrity> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#containment-integrity> ;
    touchstone:summary "Creating a resource atomically adds it to the parent container items list." ;
    touchstone:clauseText """Creation: When a new resource is created in a container, the server MUST atomically add the resource to the container's items list.""" ;
    touchstone:clauseHash "sha256-69197b04c39ff4b5af6cbdcdf4e7c6d1f3df99b3102b47657ba11a6b0fe810c4" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:containment-delete-atomic-items
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#containment-integrity> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#containment-integrity> ;
    touchstone:summary "Deleting a resource atomically removes it from the parent items list; container deletion requires emptiness unless recursion is requested." ;
    touchstone:clauseText """Deletion: When a resource is deleted, the server MUST atomically remove it from its parent container's items list. Deleting a container requires the container to be empty, unless recursive deletion is explicitly requested.""" ;
    touchstone:clauseHash "sha256-b3e028829dd23fd2bd6ca422af1f28e096cc836f91edb296184c316d9f72031c" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:containment-integrity-move
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#containment-integrity> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#containment-integrity> ;
    touchstone:summary "When the up link of a resource changes, the server atomically removes it from the former parent's items and adds it to the destination's; support for the change is optional." ;
    touchstone:clauseText """Move: When the up link of a resource is changed, the server MUST atomically remove the resource from the items list of its former parent container and add it to the items list of the destination container. Support for changing the up link is OPTIONAL, and the resulting requirements are defined in 9.6 Moving resources between containers.""" ;
    touchstone:clauseHash "sha256-d1bf22de5a4a16d52e1452eece9f463c6254e670d31cedafbd3423b2fc6f9b0b" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-10-19"^^xsd:date .

req:containment-no-orphans
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#containment-integrity> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#containment-integrity> ;
    touchstone:summary "Every non-root resource is reachable from the storage root through the containment hierarchy." ;
    touchstone:clauseText """No orphans: Every non-root resource MUST be reachable from the storage root through the containment hierarchy.""" ;
    touchstone:clauseHash "sha256-9b87dce3cd8e858059659b917a8b589fd2ec262cc7f4cc57177581e0a40100f1" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:containment-no-cycles
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#containment-integrity> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#containment-integrity> ;
    touchstone:summary "A container never directly or indirectly contains itself." ;
    touchstone:clauseText """No cycles: A container MUST NOT directly or indirectly contain itself.""" ;
    touchstone:clauseHash "sha256-cdeb85736d15fdb4e65964f9020f0caa6d79b33bac5d332af63be247178e89bf" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:uri-independent-of-hierarchy
    a touchstone:Requirement ;
    touchstone:level "SHOULD" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server, touchstone:Client ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#resource-identification-0> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#resource-identification-0> ;
    touchstone:summary "Resource URIs are independent of containment position; servers may use client hints but clients must not assume URI structure reflects containment." ;
    touchstone:clauseText """Resources are identified by URIs. The URI of a resource is independent of its position in the containment hierarchy. Servers assign URIs during resource creation and MAY incorporate client hints, but clients SHOULD NOT assume that URI structure reflects containment.""" ;
    touchstone:clauseHash "sha256-e8726936517328063ffa9f780d82aa46af2a70e6b516f534065eea6580a87b9d" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:container-listing-authorization-visibility
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#container-membership-and-authorization> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#container-membership-and-authorization> ;
    touchstone:summary "A readable container lists all members the client can access and may include members the client cannot access." ;
    touchstone:clauseText """If a client has read access to a container, the container representation MUST include the identifiers for all resources contained in that container to which the client has access. It MAY also contain the identifiers for resources contained in that container to which the client does not have access.""" ;
    touchstone:clauseHash "sha256-6bf7edb6888aa3c3ecf68c2df25fbf61abc8d0e13026c36a743eaf45ecef277e" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

## ---- containers ----

req:container-representation-required-properties
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#container-properties> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#container-properties> ;
    touchstone:summary "A container representation includes the required property set defined by the Containers section." ;
    touchstone:clauseText """A container representation MUST include the following properties:""" ;
    touchstone:clauseHash "sha256-fbd52f93602a9450bc869a6b75396a0420f282fa89cd1f28dcd91c0d5021aa3e" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:container-totalitems-accuracy
    a touchstone:Requirement ;
    touchstone:level "SHOULD" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#container-properties> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#container-properties> ;
    touchstone:summary "totalItems is the disclosable contained-resource count; it should be accurate but may be approximate." ;
    touchstone:clauseText """totalItems: An integer indicating the total number of resources contained in the container which can be disclosed to the client. This count SHOULD be accurate but MAY be approximate.""" ;
    touchstone:clauseHash "sha256-54f897d3d0517f68cebe54d64b0348493fab4a7bf7c5cc4b921f17b880c3be63" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:contained-description-required-members
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#contained-resource-description> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#contained-resource-description> ;
    touchstone:summary "Each items entry includes the required contained-resource description members." ;
    touchstone:clauseText """Each entry in the items array describes a resource contained in the container. A contained resource description MUST include:""" ;
    touchstone:clauseHash "sha256-bd2c1d30120f7215202813acaeba3600765e2434b594a8a9265c50121c8f87ff" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:contained-description-recommended-members
    a touchstone:Requirement ;
    touchstone:level "SHOULD" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#contained-resource-description> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#contained-resource-description> ;
    touchstone:summary "Contained-resource descriptions should include the recommended members." ;
    touchstone:clauseText """A contained resource description SHOULD include:""" ;
    touchstone:clauseHash "sha256-71b894da29ff862c79f5ef5b38c77547c93f494fb9359c3736b44fde39eb61ca" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:contained-format-for-dataresources
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#contained-resource-description> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#contained-resource-description> ;
    touchstone:summary "A contained resource description carries format, the member's media type, which must be present for DataResources." ;
    touchstone:clauseText """format: The media type of the resource (e.g., "text/plain", "image/jpeg"). MUST be present for DataResources.""" ;
    touchstone:clauseHash "sha256-f28e6577c5d105b5c25008e88834651a73b06afebd243d699357062382802eb3" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

## ---- operations ----

req:operations-core-four-atomic
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#operations> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#operations> ;
    touchstone:summary "Servers support the four core operations, handling each atomically and consistently; error responses inform without leaking sensitive detail." ;
    touchstone:clauseText """This section defines the four core operations that a Linked Web Storage (LWS) server MUST support. These operations manipulate resources and containers in a transport-independent manner, focusing on semantics rather than implementation details. Each operation specifies inputs, expected behaviors, and possible responses. Responses include success indicators, resource representations (where applicable), and error conditions. Implementations MUST handle these operations atomically and consistently, meaning each operation either succeeds completely or fails without partial side effects. In case of errors, responses SHOULD provide enough detail for agents to understand the issue without leaking sensitive information.""" ;
    touchstone:clauseHash "sha256-41f0ed175bf26319f9d5aff4cdb0d41d977ce6a33a409fb6a952bc4bf7b6ed46" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:linkset-standalone-rfc9264
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#metadata-0> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#metadata-0> ;
    touchstone:summary "Per-resource metadata links are available as a standalone linkset resource per RFC 9264." ;
    touchstone:clauseText """The Linkset Resource For each resource in storage, a server MUST make metadata links available as a standalone resource according to [RFC9264].""" ;
    touchstone:clauseHash "sha256-2a398ef40427f159f96f4677f31cbd9e6535ce818ca7d282d168edebf6b203ce" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:linkset-media-type-json
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#metadata-0> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#metadata-0> ;
    touchstone:summary "Linkset resources are available as application/linkset+json." ;
    touchstone:clauseText """Media Type: A linkset resource MUST be available as application/linkset+json.""" ;
    touchstone:clauseHash "sha256-d093589407fc4475a64563a971daf12c3cda143b0cde8a3705d588fa4a354e25" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:linkset-server-managed-atomic
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#metadata-0> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#metadata-0> ;
    touchstone:summary "The linkset link targets a server-managed resource; linkset updates are atomic with the associated resource operations." ;
    touchstone:clauseText """Integrity: The 'linkset' link MUST point to a server-managed resource. Updates to the linkset MUST be atomic with associated resource operations to maintain consistency.""" ;
    touchstone:clauseHash "sha256-9b0b944bccb01a5aad3e6228eae36a0c5c3347765a28be2bf535a75af87b07b2" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:link-storage-on-responses
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#metadata-0> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#metadata-0> ;
    touchstone:summary "Relevant responses carry a Link header with rel=https://www.w3.org/ns/lws#storage." ;
    touchstone:clauseText """Storage: Servers MUST include a Link header with rel="https://www.w3.org/ns/lws#storage" on relevant responses.""" ;
    touchstone:clauseHash "sha256-c424f5d5ed29047e9ad8e29ea31f9cee96e765f9803e49c26c88c6bced8632c9" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:prefer-link-relations-filtering
    a touchstone:Requirement ;
    touchstone:level "MAY" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Client ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#metadata-0> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#metadata-0> ;
    touchstone:summary "Clients may use Prefer with lws#PreferLinkRelations to include or omit specific relations." ;
    touchstone:clauseText """Preferences: Clients MAY use the Prefer header [RFC7240] with the URI https://www.w3.org/ns/lws#PreferLinkRelations to include or omit specific relations.""" ;
    touchstone:clauseHash "sha256-c435d0659b6cf60a9b42a617d09810ee1defba4035b3daf4b4b0f112d07833a7" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:metadata-capability-advertising
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#metadata-0> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#metadata-0> ;
    touchstone:summary "Core metadata may be client-modifiable; servers advertise their capabilities via standard HTTP headers." ;
    touchstone:clauseText """Modifiability Considerations Core metadata MAY be modified by clients. To ensure interoperability, servers MUST use standard HTTP headers to advertise their capabilities:""" ;
    touchstone:clauseHash "sha256-f8869cf9ca675d289c29e861396348bac07533309c77f4c7b5c203c17c595d17" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:linkset-allow-get-patch
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#metadata-0> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#metadata-0> ;
    touchstone:summary "Servers advertise GET and PATCH support on the linkset resource via the Allow header." ;
    touchstone:clauseText """Method Discovery: Servers MUST advertise support for GET and PATCH operations on the linkset resource via the Allow header.""" ;
    touchstone:clauseHash "sha256-b9e07f775964c432aee661d36fac7684705d1f1f7a5258c2c276265d3aabffb3" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:linkset-accept-patch-json-patch
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#metadata-0> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#metadata-0> ;
    touchstone:summary "Servers advertise JSON Patch support on the linkset resource via the Accept-Patch header: Accept-Patch: application/json-patch+json." ;
    touchstone:clauseText """Patch Format Discovery: Servers MUST advertise support for JSON Patch [RFC6902] via the Accept-Patch header: Accept-Patch: application/json-patch+json.""" ;
    touchstone:clauseHash "sha256-e435732e76f25996db99c487afbdc29972474c9fe49d1a124fdcd92a2b0a7239" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-10-05"^^xsd:date .

req:linkset-optional-methods-advertised
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#metadata-0> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#metadata-0> ;
    touchstone:summary "Optional PUT or alternative patch formats, when supported, appear in Allow and Accept-Patch." ;
    touchstone:clauseText """Optional Methods: Servers MAY support PUT or alternative patch formats; if supported, these MUST be included in the Allow and Accept-Patch headers respectively.""" ;
    touchstone:clauseHash "sha256-d0c17748555e50a73da87dba6de57af2aba89f427ae9b85d85004dd43b872e88" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:client-no-assumed-methods-405-415
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Client ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#metadata-0> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#metadata-0> ;
    touchstone:summary "Clients do not assume PUT or patch-format support unless advertised, and handle 405 and 415 gracefully." ;
    touchstone:clauseText """[!IMPORTANT] Clients SHOULD NOT assume support for PUT or specific patch formats unless they are advertised in the resource headers and MUST handle 405 Method Not Allowed or 415 Unsupported Media Type responses gracefully.""" ;
    touchstone:clauseHash "sha256-bd501e0a0761db6e6877d0e8b4107335b93361de3983e0726658fac7ebcc0915" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:linkset-etag-get-head
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#metadata-0> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#metadata-0> ;
    touchstone:summary "Responses to GET and HEAD on a linkset resource carry an ETag header as defined in RFC 9110." ;
    touchstone:clauseText """Managing Metadata Metadata is managed by interacting with the resource's associated linkset resource URI. Servers MUST include an ETag header as defined in [RFC9110] in responses to GET and HEAD requests.""" ;
    touchstone:clauseHash "sha256-679281d2737cb0f9b72989fb8c5b9d79af10d7d92f52321ed9eceb66312c91f6" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-30"^^xsd:date .

req:linkset-patch-json-patch
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#metadata-0> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#metadata-0> ;
    touchstone:summary "PATCH with application/json-patch+json is the primary metadata-management mechanism on the linkset." ;
    touchstone:clauseText """Partial Updates (PATCH): This is the primary mechanism for metadata management. Servers MUST support PATCH using application/json-patch+json.""" ;
    touchstone:clauseHash "sha256-4f8fd655a5d3c79231cf88a25efcdc5259b4e69376f165cf7890784cec598b66" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-10-05"^^xsd:date .

req:linkset-put-405-if-unsupported
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server, touchstone:Client ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#metadata-0> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#metadata-0> ;
    touchstone:summary "PUT may replace the entire linkset if advertised; otherwise the server rejects it with 405 Method Not Allowed." ;
    touchstone:clauseText """Replacement (PUT): If advertised in the Allow header, a client MAY replace the entire linkset. If the server does not support PUT, it MUST reject the request with 405 Method Not Allowed.""" ;
    touchstone:clauseHash "sha256-b98c59a49a65c81b1505e1010d0ec14710cc8a99b86c9796c9534e2db9c76e78" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:linkset-restricted-links-preserved
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#metadata-0> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#metadata-0> ;
    touchstone:summary "Servers may restrict modification of specific links (such as up or items), must preserve the links a client may not modify when applying a patch, and must describe a MoveResource capability if they let clients modify the up link." ;
    touchstone:clauseText """Restrictions: Servers MAY restrict modifications to specific links (like up or items) to maintain system integrity. Servers MUST preserve the links a client is not permitted to modify when applying a patch. A server that allows clients to modify the up link thereby allows resources to be moved between containers; such a server MUST describe a MoveResource capability in its storage description, as described in 6.1.3 Storage Capabilities, and the resulting requirements are defined in 9.6 Moving resources between containers.""" ;
    touchstone:clauseHash "sha256-79ce31192b7c61de1dded875e8a3505bfc9bfe445ec69dfb78734c4249cc2c76" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-10-19"^^xsd:date .

req:linkset-lifecycle-tied-to-resource
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#metadata-0> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#metadata-0> ;
    touchstone:summary "Deleting a resource automatically removes its associated linkset metadata." ;
    touchstone:clauseText """Lifecycle: Metadata lifecycles are tied to the described resource; deleting a resource MUST result in the automatic removal of its associated linkset resource metadata.""" ;
    touchstone:clauseHash "sha256-8b66649f396cd0e06d8f13cf4c2fdff0c4f83a431ab673d001b60e416e3114b0" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:create-server-managed-metadata-protected
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server, touchstone:Client ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#create-resource> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#create-resource> ;
    touchstone:summary "On create, clients may supply user-managed metadata as Link headers, but server-managed metadata is generated by the server and must not be overridden." ;
    touchstone:clauseText """New resources are created using POST to a target container URI, with the server assigning the final identifier. Clients MAY provide initial user-managed metadata for the new resource by including one or more Link headers in the POST request, following the syntax of Web Linking in [RFC8288]. Server-managed metadata MUST be generated automatically by the server upon creation and MUST NOT be overridden by client-provided links.""" ;
    touchstone:clauseHash "sha256-3bb191b576722262f4e2e0999eedd30140ecac2e2d0c10a9ac5e47e068fb1956" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:create-post-not-idempotent
    a touchstone:Requirement ;
    touchstone:level "SHOULD" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Client ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#create-resource> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#create-resource> ;
    touchstone:summary "POST is not idempotent; clients should avoid unintentional retries or use unique identifiers." ;
    touchstone:clauseText """POST is not idempotent. Repeating it may create duplicates; clients SHOULD avoid unintentional retries or use unique identifiers/checks to prevent this.""" ;
    touchstone:clauseHash "sha256-6cb36868f65e6e4a7ecea646c0e5971b396044f8894feb8ee2fc2ef995c89885" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:create-linkset-before-success
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#create-resource> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#create-resource> ;
    touchstone:summary "The linkset resource is created and populated with mandatory server-managed fields before creation success is returned." ;
    touchstone:clauseText """Metadata updates are atomic; servers MUST ensure the linkset resource is created and populated with mandatory server-managed fields before returning success.""" ;
    touchstone:clauseHash "sha256-ee9af89be373049625b61ef562af9e6a181bf8dcef4592161b9c67a58db8cb19" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:create-401-storage-link
    a touchstone:Requirement ;
    touchstone:level "SHOULD" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#create-resource> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#create-resource> ;
    touchstone:summary "401 responses should include a Link header with rel=https://www.w3.org/ns/lws#storage so clients can discover the storage without hardcoded URIs." ;
    touchstone:clauseText """For discoverability, servers SHOULD include a Link header with rel="https://www.w3.org/ns/lws#storage" on 401 responses to guide clients without hardcoded URIs.""" ;
    touchstone:clauseHash "sha256-d273c650e8ff8a5c23d12769200524903292c0568d57c9f8f4721b63ecca6556" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:read-container-listing-authz-filtered
    a touchstone:Requirement ;
    touchstone:level "MAY" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#read-resource> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#read-resource> ;
    touchstone:summary "A container GET returns a member listing that may be authorization-filtered, with core metadata per member." ;
    touchstone:clauseText """For containers, the server returns a listing of member resources which MAY be filtered based on authorization. Listings must include core metadata for each member.""" ;
    touchstone:clauseHash "sha256-fb5d6bec88e1abc35335caa99326773e9032f7e3bd745d60f99ad583b5057aa0" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:read-type-distinction-metadata-links
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#read-resource> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#read-resource> ;
    touchstone:summary "Servers distinguish resource types via metadata; all read responses integrate Link headers rel=linkset, rel=up and rel=type, atomically with resource state." ;
    touchstone:clauseText """The read resource operation requests a resource representation with HTTP GET requests (and HEAD for header-only requests). The behavior differs depending on whether the target URL is a container or a non-container resource (data resource). Servers MUST distinguish resource types via metadata. All responses MUST integrate with metadata as defined in Section 8.1, including Link headers for key relations such as rel="linkset", rel="up", and rel="type". Servers MUST ensure atomicity between the resource state and its metadata during reads.""" ;
    touchstone:clauseHash "sha256-64809767d0e82c46c4abae2a7ded86b69b362d55bf77aedca1e79ca3b59e9b0a" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:read-container-listing-member-metadata
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#read-resource> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#read-resource> ;
    touchstone:summary "An application/lws+json container listing includes member identifiers and types (required), media types for DataResources (required), and sizes and timestamps (recommended)." ;
    touchstone:clauseText """GET (container resource) – List a container's contents: When the target URI corresponds to a container (determined via metadata type), a GET request returns a listing of the container's members. A response with Content-Type: application/lws+json is a container representation as defined in the Container Representation section; for this representation, the listing includes metadata for each member: resource identifiers (MUST), types (MUST), media types (MUST for DataResources), sizes (SHOULD), and modification timestamps (SHOULD).""" ;
    touchstone:clauseHash "sha256-0e960e2417dc5f61be3adb2895081b52237e223b7a4b07c4a07e2c97b74bd78a" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:read-container-etag-type-links
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#read-resource> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#read-resource> ;
    touchstone:summary "Container responses carry an ETag plus Link headers rel=linkset, rel=up and rel=type indicating a container." ;
    touchstone:clauseText """In all cases, the server MUST include the following metadata in the response headers: an ETag header as defined in [RFC9110], and Link headers with rel="linkset", rel="up", and rel="type" indicating it is a container.""" ;
    touchstone:clauseHash "sha256-7e7f686b048a64ae5af5442b5ee37f4673f399f3a3a57b96aa5005bc8479784a" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-30"^^xsd:date .

req:conditional-requests-supported
    a touchstone:Requirement ;
    touchstone:level "SHOULD" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#read-resource> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#read-resource> ;
    touchstone:summary "Servers SHOULD support RFC 9110 conditional requests (entity tags, date validators) and answer 304 Not Modified when nothing changed." ;
    touchstone:clauseText """Caching and Conditional Requests: LWS leverages HTTP caching semantics. Servers SHOULD support conditional requests as defined in [RFC9110], including mechanisms such as entity tags (ETags) and date-based validators (like If-Modified-Since headers). If the resource or container listing has not changed, respond with 304 Not Modified to avoid redundant transfers.""" ;
    touchstone:clauseHash "sha256-d280b7551e08228c1417b6521640c6fa8cc18bff15d6d98c43ea9b31b558277b" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-30"^^xsd:date .

req:update-content-vs-metadata-prefer-set-linkset
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server, touchstone:Client ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#update-resource> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#update-resource> ;
    touchstone:summary "PUT/PATCH on a resource URI modify content only; combined content+metadata updates are opt-in via Prefer: set-linkset (optional for servers; otherwise ignored or 501)." ;
    touchstone:clauseText """The update resource modifies the contents of an existing served resource by a PUT request (to replace the entire resource) or a PATCH request (to apply a partial modification). The client must have write access to the resource's URL to perform these operations. Note: This section describes updating a resource's primary content. To update its metadata, see Section 9.3.2. LWS servers MUST handle PUT and PATCH requests on resource URIs as modifications to the resource content only, with no default impact on the associated linkset resource. To optionally update both content and metadata in a single atomic operation, clients MAY include Link headers in the PUT/PATCH request to the resource URI and specify the preference 'Prefer: set-linkset' (as defined in [RFC7240]). In this case, the server MUST interpret the provided Link headers as a replacement (for PUT) or partial update (for PATCH) to the linkset, in addition to applying the content changes. This behavior is OPTIONAL for servers but, if supported, MUST be invoked explicitly via the Prefer header to prevent unintentional metadata overwrites. Servers that do not support combined updates MUST ignore the preference or respond with 501 Not Implemented.""" ;
    touchstone:clauseHash "sha256-6936b30f24267d1b23dfe841292b72596eaeedec8019e9dccf7eb55e262ff2ce" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-30"^^xsd:date .

req:put-clients-use-conditional-requests
    a touchstone:Requirement ;
    touchstone:level "SHOULD" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server, touchstone:Client ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#update-resource> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#update-resource> ;
    touchstone:summary "Clients SHOULD make PUT conditional (RFC 9110) to avoid overwriting concurrent changes; PUT is idempotent for existing resources." ;
    touchstone:clauseText """PUT (replace full resource) – Send PUT to the resource URI with new full content in the body and matching Content-Type (generally consistent with existing type). PUT is idempotent for existing resources. Clients SHOULD use conditional requests as defined in [RFC9110] to avoid overwriting concurrent changes.""" ;
    touchstone:clauseHash "sha256-d41d496331613fa60404a9f04013bbce993ce14571a35a2272c7645661b15fb1" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-30"^^xsd:date .

req:patch-json-patch-baseline
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#update-resource> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#update-resource> ;
    touchstone:summary "PATCH minimally supports JSON Patch (application/json-patch+json, RFC 6902)." ;
    touchstone:clauseText """LWS server MUST minimally support JSON Patch (application/json-patch+json) as defined in [RFC6902].""" ;
    touchstone:clauseHash "sha256-d56405267abe1dbba8f230b14fc341be36afbff27016213543495844a585c420" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-10-05"^^xsd:date .

req:linkset-precondition-failed-412
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server, touchstone:Client ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#update-resource> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#update-resource> ;
    touchstone:summary "A conditional PUT or PATCH on a linkset whose precondition fails is rejected with 412 Precondition Failed; servers and clients SHOULD use conditional requests there." ;
    touchstone:clauseText """Conditional Requests for Metadata Because a resource's metadata can be modified by multiple actors, preventing concurrent overwrites is important. Servers and clients SHOULD use conditional requests as defined in [RFC9110] for PUT and PATCH operations on a linkset resource. When a server receives a conditional request for which the precondition fails, it MUST reject the request with a 412 Precondition Failed status code. Example (PUT to replace a linkset): A client first fetches the linkset.""" ;
    touchstone:clauseHash "sha256-721e92a204dfb8a929fb3e5f7de9206722b28fd82d775a1cd4293a26ffe9b210" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-30"^^xsd:date .

req:delete-if-match-optional
    a touchstone:Requirement ;
    touchstone:level "MAY" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Client ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#delete-resource> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#delete-resource> ;
    touchstone:summary "DELETE targets the resource URI; clients may include If-Match for concurrency checks." ;
    touchstone:clauseText """The DELETE request targets the URI of the resource or container to remove. Clients MAY include an If-Match header with an ETag for concurrency checks.""" ;
    touchstone:clauseHash "sha256-6fa3588b048f7da592e836ba361e582466e61ef768abbb16139191491c75cbd9" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:delete-success-204-conditional
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#delete-resource> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#delete-resource> ;
    touchstone:summary "Successful DELETE responds 204 No Content; conditional requests should be supported." ;
    touchstone:clauseText """On success, the server MUST respond with 204 No Content. Servers SHOULD support conditional requests, as defined in [RFC9110].""" ;
    touchstone:clauseHash "sha256-9fe96c6f76021921c846f5b50a6a8088273e6a330d1ac48a9e2d44614c83b225" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:delete-401-403-404-semantics
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#delete-resource> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#delete-resource> ;
    touchstone:summary "Unauthorized deletes yield 403 for a known identity with insufficient permission or 401 without valid authentication; 404 may hide existence." ;
    touchstone:clauseText """If the client lacks authorization, the server MUST return 403 Forbidden (if the client's identity is known but permissions are insufficient) or 401 Unauthorized (if no valid authentication is provided). In cases where revealing resource existence poses a security risk, the server MAY return 404 Not Found instead.""" ;
    touchstone:clauseHash "sha256-917938d291954d85b44d95add4bfca0cdc5ce76800742a59dc8af1fd55bba4dd" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:move-server-support
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#moving-resources> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#moving-resources> ;
    touchstone:summary "A server that lets clients modify the up link describes a MoveResource capability and meets the moving requirements; one that does not rejects the change with a 4xx and describes no MoveResource capability." ;
    touchstone:clauseText """Server support: The up link is managed by the server, and servers are not required to allow clients to modify it, as described in 9.1 Resource metadata. A server that allows clients to modify the up link of a resource, and thereby to move resources between containers, MUST describe a MoveResource capability in its storage description, as described in 6.1.3 Storage Capabilities, and MUST implement the requirements in this section. A server that does not allow it MUST reject the request with an appropriate 4xx status code, such as 409 Conflict, and MUST NOT describe a MoveResource capability.""" ;
    touchstone:clauseHash "sha256-509b24123815f9340446ae7e7915295967c86269da6ee678949cc93d3a8b0ed8" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-10-19"^^xsd:date .

req:move-request-json-patch
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server, touchstone:Client ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#moving-resources> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#moving-resources> ;
    touchstone:summary "A move is a JSON Patch of the resource's linkset replacing the up target, which servers must accept; clients should send If-Match, and servers may answer an unconditional one with 428." ;
    touchstone:clauseText """Requesting a move: A client moves a resource by applying a partial update to the resource's linkset resource, replacing the target of the up link with the identifier of the destination container. As required by 9.1 Resource metadata, servers MUST support application/json-patch+json [RFC6902] for this update. As for any modification of a linkset resource, clients SHOULD make the request conditional by including an If-Match header field carrying the current ETag of the linkset resource, as described in 9.4 Update resource; servers MAY require a conditional request and reject an unconditional one with 428 Precondition Required.""" ;
    touchstone:clauseHash "sha256-485504124fbc00b3ecada75608ea82f67f67fa867c5a044f2e4a4356fff9f902" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-10-19"^^xsd:date .

req:move-destination-existing-container
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#moving-resources> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#moving-resources> ;
    touchstone:summary "A move's destination must be an existing container; a patch setting up to anything else, or removing the up link, is rejected with a 4xx." ;
    touchstone:clauseText """The destination MUST be an existing container. Servers MUST reject a patch that would set the target of the up link to anything other than an existing container with an appropriate 4xx status code, such as 409 Conflict. Servers MUST likewise reject a patch that would leave the resource without an up link, as every non-root resource is reachable from the storage root.""" ;
    touchstone:clauseHash "sha256-18ecb910bf4a9294612d5fa95bfd89701ab6cd158b9423fbbb9c94f1986e013b" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-10-19"^^xsd:date .

req:move-cross-storage-may-reject
    a touchstone:Requirement ;
    touchstone:level "MAY" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#moving-resources> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#moving-resources> ;
    touchstone:summary "Servers may reject, with a 4xx, a move into a container in a different storage; one that accepts it still meets the other moving requirements." ;
    touchstone:clauseText """This specification does not restrict the destination to the storage that holds the resource being moved. However, servers are not required to support moving a resource to a container in a different storage, and MAY reject such a patch with an appropriate 4xx status code, such as 409 Conflict. A server that accepts such a patch remains subject to the other requirements in this section, including the requirement to apply the change atomically.""" ;
    touchstone:clauseHash "sha256-79613fa9247013636ec7bbf505e9960fb4d6f8cb83db2300e5982ee98f2248d9" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-10-19"^^xsd:date .

req:move-containment-atomic
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#moving-resources> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#moving-resources> ;
    touchstone:summary "A successful move atomically removes the resource from the former parent's items and adds it to the destination's; both containers' ETags change, and their totalItems should." ;
    touchstone:clauseText """Effect on containment: On a successful update, the server MUST atomically remove the resource from the items list of its former parent container and add it to the items list of the destination container. The totalItems count of both containers SHOULD be updated accordingly, and the ETag of both containers MUST be updated to reflect the change.""" ;
    touchstone:clauseHash "sha256-ab459c8c262b4a3c62bd79d5abf59d573b7efd082c57a9efb3ea61d335894885" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-10-19"^^xsd:date .

req:move-preserves-content-and-links
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#moving-resources> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#moving-resources> ;
    touchstone:summary "A move leaves the resource's content and user-defined metadata unaffected, preserves the linkset links the client may not modify, and keeps auxiliary resources bound to it." ;
    touchstone:clauseText """The content of the moved resource and its user-defined metadata are unaffected by the move. Servers MUST preserve the links in the linkset resource that the client is not permitted to modify, including server-managed links such as linkset and type. Auxiliary resources whose lifetime is bound to the moved resource remain bound to it after the move.""" ;
    touchstone:clauseHash "sha256-515b21ca71fad4dc8ad2073ca2c4c1220aefd7920dc4146141cf1241aec554cc" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-10-19"^^xsd:date .

req:move-containment-integrity-cycles
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#moving-resources> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#moving-resources> ;
    touchstone:summary "A move that would violate containment integrity is rejected with a 4xx; a container is never moved into itself or one of its descendants." ;
    touchstone:clauseText """Servers MUST reject an update that would violate the containment integrity requirements in 7. Logical Resource Organization with an appropriate 4xx status code, such as 409 Conflict. In particular, a container MUST NOT be moved into itself or into one of its own descendants, as this would introduce a cycle in the containment hierarchy.""" ;
    touchstone:clauseHash "sha256-5889e7b9f42ebac333c3919a022712f30b4c41002bac09d9aacb3d00478a7427" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-10-19"^^xsd:date .

req:move-identifier-preserved
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server, touchstone:Client ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#moving-resources> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#moving-resources> ;
    touchstone:summary "Servers should preserve the identifier of a moved resource and should declare whether they do with preservesIdentifier; absent it, clients do not assume they do." ;
    touchstone:clauseText """Identity of the moved resource: The URI of a resource is independent of its position in the containment hierarchy, as described in 7. Logical Resource Organization. Servers SHOULD therefore preserve the identifier of a moved resource, so that existing links to it remain valid, and SHOULD declare whether they do so with the preservesIdentifier property of the MoveResource capability. In the absence of that property, clients MUST NOT assume that identifiers are preserved.""" ;
    touchstone:clauseHash "sha256-45d6600ff552220fdf3c8e78c76c1cff9a6a6803c3f66f0307932b0a44e910df" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-10-19"^^xsd:date .

req:move-new-identifier-response
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#moving-resources> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#moving-resources> ;
    touchstone:summary "A server that does not preserve a moved resource's identifier answers 200 with the updated linkset anchored at the new identifier and a Content-Location naming the linkset's new URI; it should answer 301 at the old identifiers." ;
    touchstone:clauseText """A server that does not preserve the identifier of a moved resource MUST respond with 200 OK and a representation of the updated linkset resource whose anchor is the new identifier of the resource, and MUST include a Content-Location header field carrying the new identifier of the linkset resource itself. Such a server SHOULD respond to subsequent requests on the previous identifiers of the resource and of its auxiliary resources with 301 Moved Permanently, including a Location header field pointing at the new identifier.""" ;
    touchstone:clauseHash "sha256-5b63860a58effc957df5dc4426532796bc401e0795b3f576ff24a5992d13cbf1" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-10-19"^^xsd:date .

req:move-containers-applies-to
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#moving-resources> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#moving-resources> ;
    touchstone:summary "Servers may let clients move containers and then list Container in the MoveResource appliesTo; otherwise they reject a container move with a 4xx and do not list Container." ;
    touchstone:clauseText """Moving containers: Servers MAY support changing the up link of a container, and MUST indicate that they do so by including Container in the appliesTo property of the MoveResource capability. When a container is moved, its descendants move with it, and their identifiers are subject to the same requirements as the identifier of the moved container. A server that supports moving data resources but not containers MUST reject such a request with an appropriate 4xx status code, such as 409 Conflict, and MUST NOT include Container in the appliesTo property.""" ;
    touchstone:clauseHash "sha256-167387dae209a9714f3c035c4f020c0f21e879b3f59602fab8fa329cbe5fc696" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-10-19"^^xsd:date .

req:move-authorization-delete-and-create
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#moving-resources> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#moving-resources> ;
    touchstone:summary "A server applies a change to an up link only when the agent may delete the moved resource and create in the destination container." ;
    touchstone:clauseText """Authorization: A server MUST NOT apply a change to an up link unless the requesting agent is authorized both to perform the delete resource operation on the resource being moved and to perform the create resource operation in the destination container.""" ;
    touchstone:clauseHash "sha256-a202b854a99f1cb805dd00586d372a107f829cbdde2067b9dad775c75dae5079" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-10-19"^^xsd:date .

req:move-container-subtree-authorization
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#moving-resources> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#moving-resources> ;
    touchstone:summary "Moving a container requires the authorization to delete it recursively plus to create in the destination, evaluated for the whole subtree before the change, which is never applied partially." ;
    touchstone:clauseText """When a container is moved, the container is the only resource whose parent changes: its descendants keep their position relative to one another, and, where the server preserves identifiers, keep their identifiers as well. The agent is therefore not required to be authorized to recreate each descendant in the destination. The policies that apply to those descendants may nevertheless change, because access is frequently governed in terms of position in the containment hierarchy. For this reason, the authorization required to move a container is the authorization required to delete it recursively, as described in 9.5 Delete resource, together with the authorization to create in the destination container. A server MUST evaluate that authorization for the whole subtree before applying the change, and MUST NOT apply the change partially.""" ;
    touchstone:clauseHash "sha256-41c636719bf91e7cf592826c05e61cc4348adac568d1b0044483e00a2fa998fc" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-10-19"^^xsd:date .

req:move-notification-single-activity
    a touchstone:Requirement ;
    touchstone:level "SHOULD" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#moving-resources> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#moving-resources> ;
    touchstone:summary "A server that supports moves and emits notifications should describe a successful move with a single Move activity, not a Delete and a Create." ;
    touchstone:clauseText """Notifications: A server that advertises support for moving resources and emits notifications SHOULD describe a successful move with a single Move activity, as described in 10.2.3 Activity Types, rather than with a separate Delete and Create activity.""" ;
    touchstone:clauseHash "sha256-f0853661ceac425c064660602b798bf47b8b5097f78df75e1e09dcedcc63d96a" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-10-19"^^xsd:date .

req:status-204-410-deletions
    a touchstone:Requirement ;
    touchstone:level "MAY" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#summary-of-http-status-mappings> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#summary-of-http-status-mappings> ;
    touchstone:summary "204 indicates success without a body; servers may use 410 Gone for permanent deletions." ;
    touchstone:clauseText """No response body. Indicates the resource was deleted or the request succeeded and there's nothing else to say. Servers MAY use 410 Gone for permanent deletions.""" ;
    touchstone:clauseHash "sha256-4822e9bfa9594ef4d5ecfa8dbbbf051b487639f796ef9cc61a6c0fd3077de7f2" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-30"^^xsd:date .

req:error-rfc9457-problem-details
    a touchstone:Requirement ;
    touchstone:level "SHOULD" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#summary-of-http-status-mappings> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#summary-of-http-status-mappings> ;
    touchstone:summary "Error responses should use the RFC 9457 problem-details format." ;
    touchstone:clauseText """Error details explaining what was wrong. Servers SHOULD use the standard format defined in [RFC9457] for structured error responses, such as a JSON object with fields like "type", "title", "status", "detail", and "instance".""" ;
    touchstone:clauseHash "sha256-eef6ebf9bd2e4de309863150da8e52bf04255aaf6133a0cf3e3ac1d30e22f2e9" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

## ---- notifications ----

req:notifications-advertise-notificationservice
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#notification-discovery> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#notification-discovery> ;
    touchstone:summary "A storage supporting notifications advertises a NotificationService service object in its storage description." ;
    touchstone:clauseText """A storage MAY support notifications. A storage that supports notifications MUST advertise a service object in the service array of its storage description resource with type equal to NotificationService.""" ;
    touchstone:clauseHash "sha256-51c4d3a55db521c16a4cdbc184801bc0d52b8629d9d9928c63d6fbe8c5f064e3" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:notificationservice-endpoint-and-subscription-types
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#notification-discovery> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#notification-discovery> ;
    touchstone:summary "A NotificationService includes a serviceEndpoint for the subscription endpoint and a subscriptionType array of supported subscription types." ;
    touchstone:clauseText """The service object MUST include a serviceEndpoint property whose value is the URI of the subscription endpoint. The service object MUST include a subscriptionType property whose value is an array of strings, each identifying a supported subscription type.""" ;
    touchstone:clauseHash "sha256-4877cace8964758ad6a21493e8378cbc67bcc340afb0ce5b082d41ef512a4302" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:notificationservice-additional-properties
    a touchstone:Requirement ;
    touchstone:level "MAY" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#notification-discovery> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#notification-discovery> ;
    touchstone:summary "Additional properties may appear on the notification service object." ;
    touchstone:clauseText """Additional properties MAY be present on the service object.""" ;
    touchstone:clauseHash "sha256-6d536531b0c76aa42f1f4ef12e0e73dff20cf70e411874ade78478c852474a20" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:notification-envelope-type
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#envelope-properties> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#envelope-properties> ;
    touchstone:summary "A notification envelope carries a required type whose value is the string Notification." ;
    touchstone:clauseText """type — REQUIRED. The value MUST be the string Notification.""" ;
    touchstone:clauseHash "sha256-1631b6c732d009b3d6e1b4ca80d341cbee9dc1084eb2fb247b6e5ef10b420f7d" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:notification-envelope-storage
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#envelope-properties> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#envelope-properties> ;
    touchstone:summary "A notification envelope carries a required storage property identifying the LWS storage it concerns." ;
    touchstone:clauseText """storage — REQUIRED. A URI identifying the LWS storage with which the notification is associated.""" ;
    touchstone:clauseHash "sha256-34415617fa01c45f3d4fbda0ed02151c8842d5668a3b51fe20ad38520d4395c0" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:notification-envelope-activity
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#envelope-properties> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#envelope-properties> ;
    touchstone:summary "A notification envelope carries a required activity property: one or more Activity Streams 2.0 objects describing what occurred." ;
    touchstone:clauseText """activity — REQUIRED. A JSON object or an array of JSON objects, each conforming to the Activity Streams 2.0 data model, describing the event or events that occurred. See 10.2.2 Activity Properties.""" ;
    touchstone:clauseHash "sha256-7205e4212940e9c9720efe78ab21f4a494b484e2777baf696411689fd51bcc45" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:notification-activity-as2-conformance
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#activity-properties> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#activity-properties> ;
    touchstone:summary "Each activity object conforms to the Activity Streams 2.0 data model and includes the required activity properties." ;
    touchstone:clauseText """Each activity object within the activity property MUST conform to the Activity Streams 2.0 data model and MUST include the following properties:""" ;
    touchstone:clauseHash "sha256-b03249c25203e9452b4989180e65ae8ed50154b88c3362772639385615aea834" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:notification-activity-id
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#activity-properties> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#activity-properties> ;
    touchstone:summary "An activity object carries a required id uniquely identifying the activity." ;
    touchstone:clauseText """id — REQUIRED. A string uniquely identifying the activity.""" ;
    touchstone:clauseHash "sha256-61ec9855bf5f37a46e32463baa20539873a77ddba21fcc22d3c3216aa9d82a92" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:notification-activity-type
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#activity-properties> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#activity-properties> ;
    touchstone:summary "An activity object carries a required type: an array holding at least one Activity Streams 2.0 activity type." ;
    touchstone:clauseText """type — REQUIRED. An array of strings containing at least one Activity Streams 2.0 activity type.""" ;
    touchstone:clauseHash "sha256-0641ca15e3f158c1423d6e054aa12ae76d353e1729b3e3abecd1e0ebc9f630aa" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:notification-activity-object-id
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#activity-properties> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#activity-properties> ;
    touchstone:summary "The activity object property carries a required id: the URI of the resource the notification is about." ;
    touchstone:clauseText """id — REQUIRED. The URI of the resource.""" ;
    touchstone:clauseHash "sha256-2f29d963a0a375df1893ff2954ccf3f9077d7bd3f951ba415bff855ceb2f729b" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:notification-activity-object-type
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#activity-properties> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#activity-properties> ;
    touchstone:summary "The activity object property carries a required type array holding at least one resource type, such as Container or DataResource." ;
    touchstone:clauseText """type — REQUIRED. An array of strings containing at least one resource type. Values defined by this specification include Container and DataResource. Additional type values MAY be included.""" ;
    touchstone:clauseHash "sha256-7fe4b358550d69385f939e456f6f8d1958e68bf32b282c0fef6d7c18e821d436" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:notification-activity-object
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#activity-properties> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#activity-properties> ;
    touchstone:summary "An activity carries a required object identifying the resource the notification is about, with its own required properties." ;
    touchstone:clauseText """object — REQUIRED. A JSON object identifying the resource that the notification is about. The object MUST include the following properties:""" ;
    touchstone:clauseHash "sha256-081948d6ed9cfe2ba7cebd0389b2ed3ea200e6ae0fe4819212b5bb56a47163a7" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:notification-activity-published
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#activity-properties> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#activity-properties> ;
    touchstone:summary "An activity carries a required published datetime, per RFC 3339, saying when it occurred." ;
    touchstone:clauseText """published — REQUIRED. A datetime value conforming to [RFC3339] indicating when the activity occurred.""" ;
    touchstone:clauseHash "sha256-2bca43ad96dfae06b363d94d4d4a6c3b8c33bff648324ddc1fcf7562723c8455" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:notification-activity-optional-properties
    a touchstone:Requirement ;
    touchstone:level "MAY" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#activity-properties> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#activity-properties> ;
    touchstone:summary "The remaining activity properties are optional." ;
    touchstone:clauseText """The following properties are OPTIONAL:""" ;
    touchstone:clauseHash "sha256-7be8a2b04a8b3985baa1d4f75962e337d8dd4e968cf2e75aa319cbdc049be639" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:notification-activity-types-supported
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#activity-types> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#activity-types> ;
    touchstone:summary "A server supports the listed Activity Streams 2.0 activity types for signalling LWS resource changes." ;
    touchstone:clauseText """A server MUST support the following Activity Streams 2.0 activity types to indicate Storage Resource changes:""" ;
    touchstone:clauseHash "sha256-732b405c2e7a51d121310ff59d375d302f5b1f07d7bd69569441b4c7e8d235a6" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-30"^^xsd:date .

req:notification-activity-move
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#activity-types> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#activity-types> ;
    touchstone:summary "A server that lets clients move resources between containers supports the Move activity type, with origin, target and the moved object." ;
    touchstone:clauseText """A server that allows clients to move resources between containers, as described in 9.6 Moving resources between containers, MUST support the following activity type:""" ;
    touchstone:clauseHash "sha256-11058787199099cea64544e2d6527a3ce312d0222689df5fa3b7287d1c8bf6e8" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-10-19"^^xsd:date .

req:notification-activity-types-additional
    a touchstone:Requirement ;
    touchstone:level "MAY" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#activity-types> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#activity-types> ;
    touchstone:summary "A server may support activity types beyond the ones this specification lists." ;
    touchstone:clauseText """Other activity types MAY also be supported.""" ;
    touchstone:clauseHash "sha256-062f17007d82157f8334f27d1a3e520e0525131b50b3ce078440fcbc254f3aa8" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:notification-batching
    a touchstone:Requirement ;
    touchstone:level "MAY" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#batching> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#batching> ;
    touchstone:summary "A server may batch several activities into one envelope by giving the activity property an array." ;
    touchstone:clauseText """A server MAY combine multiple activities into a single notification envelope by providing an array of activity objects as the value of the activity property.""" ;
    touchstone:clauseHash "sha256-12b2eb281ff90a48314f223c398d57764d142126ae5d3df983ed23726c7bc2f6" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:subscription-create-post-lws-json
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Client ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#subscriptions> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#subscriptions> ;
    touchstone:summary "A subscription is created by an authenticated POST to the NotificationService endpoint with an application/lws+json body." ;
    touchstone:clauseText """To receive notifications, a subscriber creates a subscription by sending an authenticated POST request to the serviceEndpoint of the NotificationService. The request body MUST conform to the application/lws+json media type.""" ;
    touchstone:clauseHash "sha256-c95c37ff5c2b9f1a6d1bd8383160f303d3301444a020e62c6d07f15ae9b5d691" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:subscription-request-required-fields
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Client ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#subscription-request> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#subscription-request> ;
    touchstone:summary "A subscription request contains the required subscription fields." ;
    touchstone:clauseText """A subscription request MUST contain the following fields:""" ;
    touchstone:clauseHash "sha256-13d986b5f499408d26a4b46f19ccb54118a9fbc3b26bacd84b0895b6f8226c22" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:subscription-request-type
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Client ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#subscription-request> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#subscription-request> ;
    touchstone:summary "A subscription request carries a required type, one of the subscription types the NotificationService advertises." ;
    touchstone:clauseText """type — REQUIRED. A string identifying the subscription type. The value MUST be one of the types listed in the subscriptionType array of the NotificationService.""" ;
    touchstone:clauseHash "sha256-0616cddf234b5a366e515cbfbd8507dd7e564019dc9fed9cf673e5752fd3359d" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:subscription-request-topic
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Client ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#subscription-request> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#subscription-request> ;
    touchstone:summary "A subscription request carries a required topic: an array of URIs naming the resources in scope." ;
    touchstone:clauseText """topic — REQUIRED. An array of URIs identifying the resources included in the subscription.""" ;
    touchstone:clauseHash "sha256-1999d9ba3082a68e6550c53e73ba2a93632446ae8e69a65a62fcf75a690b1f0f" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:subscription-request-additional-fields
    a touchstone:Requirement ;
    touchstone:level "MAY" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Client ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#subscription-request> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#subscription-request> ;
    touchstone:summary "A subscription request may carry further fields required by its subscription type." ;
    touchstone:clauseText """A subscription request MAY contain additional fields as required by the specific subscription type.""" ;
    touchstone:clauseHash "sha256-0aff702e037b699bfbeb0faff769bd0925d9f8ab4a3496fc6165d7a3a5a94cd2" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:subscription-authorization-on-create
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#subscription-authorization> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#subscription-authorization> ;
    touchstone:summary "A server enforces resource authorization when a subscription is created, rejecting one whose topic includes resources the subscriber cannot read." ;
    touchstone:clauseText """A server MUST enforce resource authorization when creating a subscription. If a subscriber does not have the equivalent of read access to all resources listed in the topic array, the server MUST reject the subscription request.""" ;
    touchstone:clauseHash "sha256-795fd2b1bc0d213e7e5c8f5b57d92112488dd53a7cf1cda9f20b8caef92b01c8" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:subscription-authorization-on-delivery
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#subscription-authorization> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#subscription-authorization> ;
    touchstone:summary "A server enforces authorization at delivery time and never delivers a notification for a resource the subscriber cannot read when the event occurs." ;
    touchstone:clauseText """Authorization MUST also be enforced at notification delivery time. A server MUST NOT deliver a notification about a resource that the subscriber is not authorized to read at the time the event occurs. This applies to all resources within the scope of a subscription, including resources in subcontainers.""" ;
    touchstone:clauseHash "sha256-84fc32c68d819412fd9433bb968c69c3b6a4b152cb769ea750e222cfb5b49afc" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:subscription-authorization-revoked
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#subscription-authorization> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#subscription-authorization> ;
    touchstone:summary "When access is revoked the server stops delivering for the affected resources, without terminating the whole subscription unless all access in the topic is lost." ;
    touchstone:clauseText """If the subscriber's access to a resource or container within the scope of a subscription is revoked after the subscription is created, the server MUST stop delivering notifications for the affected resources. The server SHOULD NOT terminate the entire subscription unless the subscriber has lost access to all resources in the topic array.""" ;
    touchstone:clauseHash "sha256-a9b1d38a4420442fd399a99fe65c0aeee59c2ce339b9364cd2cb992d417fc0b3" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:subscription-response-lws-json
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#subscription-response> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#subscription-response> ;
    touchstone:summary "A successful subscription response conforms to application/lws+json and carries the required response fields." ;
    touchstone:clauseText """The response to a successful subscription creation request MUST conform to the application/lws+json media type and MUST contain the following fields:""" ;
    touchstone:clauseHash "sha256-96cbeee6d7a26c4761f4e307b42fc5ae2a22b071f5e9dbfdc7b560d29071589e" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:subscription-response-type
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#subscription-response> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#subscription-response> ;
    touchstone:summary "A subscription response carries a required type equal to the subscription type from the request." ;
    touchstone:clauseText """type — REQUIRED. A string equal to the subscription type from the request.""" ;
    touchstone:clauseHash "sha256-02d3937138d850e966776b99d70902fde603f623a3d9c1ac271179fa79f1a0b1" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:subscription-response-subscription-url
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#subscription-response> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#subscription-response> ;
    touchstone:summary "A subscription response carries a required subscription property: the URL representing the subscription." ;
    touchstone:clauseText """subscription — REQUIRED. A URL representing the subscription.""" ;
    touchstone:clauseHash "sha256-1a48c5d0633b119999c2d4a3710e80b666edf9397a2d4240b731d85942b94ece" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:notification-suite-subscription-type-identifier
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Specification ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#notification-subscription-type-identifier> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#notification-subscription-type-identifier> ;
    touchstone:summary "Every notification suite is associated with a subscription type string, used in subscriptionType arrays and in subscription requests." ;
    touchstone:clauseText """Each notification suite MUST be associated with a subscription type string. The subscription type string is used in the subscriptionType array of a NotificationService and in the type field of a subscription request.""" ;
    touchstone:clauseHash "sha256-b0b8e13b7ac46e1d30f9746798eba532d58a5be33002bf0b4ca29db4451a5158" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

## ---- access-requests-and-grants ----

req:access-services-advertised
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#access-discovery> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#access-discovery> ;
    touchstone:summary "Advertised access endpoints use service objects typed AccessRequestService / AccessGrantService, with conformsTo listing supported access profiles." ;
    touchstone:clauseText """A storage MAY advertise support for access requests and access grants in its storage description resource. When such support is advertised, a service object describing an endpoint for access requests MUST have a type equal to the string AccessRequestService, and a service object describing an endpoint for access grants MUST have a type equal to the string AccessGrantService. A service object SHOULD include a conformsTo property whose value is a collection of one or more URIs identifying the access profiles supported at that endpoint. Additional properties MAY be included:""" ;
    touchstone:clauseHash "sha256-a2a5f5958e9fed9ea9b8c3e4868064df8d36b1f855d556f900fdab867cecbfc2" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:access-extra-properties-allowed
    a touchstone:Requirement ;
    touchstone:level "MAY" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server, touchstone:Client ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#access-data-model> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#access-data-model> ;
    touchstone:summary "Other properties may be present on access requests and access grants." ;
    touchstone:clauseText """Other properties MAY be present on access requests and access grants.""" ;
    touchstone:clauseHash "sha256-90b55e45aa3f0e1f9831fff04871faf697cd7a28582e6b843c79aa0fecb0d846" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:access-type-values
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server, touchstone:Client ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#access-type-property> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#access-type-property> ;
    touchstone:summary "The type value includes AccessRequest for requests or AccessGrant for grants; additional types are allowed." ;
    touchstone:clauseText """The value of the type property MUST be one or more terms and absolute URL strings. For an access request, the value MUST include the term AccessRequest. For an access grant, the value MUST include the term AccessGrant. Additional type values MAY be included.""" ;
    touchstone:clauseHash "sha256-b7c3e541db02e272a3cce16a73e7efe35d1e96e1501840742895eff3e49380fc" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:access-type-required
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server, touchstone:Client ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#access-type-property> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#access-type-property> ;
    touchstone:summary "The type property on access requests and grants is required." ;
    touchstone:clauseText """This property is REQUIRED.""" ;
    touchstone:clauseHash "sha256-734b933ebef24f55bf7724fbf2a2fb4c904e35149c12d59f00e5aa4be47a6201" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

