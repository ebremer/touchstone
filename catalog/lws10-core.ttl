req:access-inbox-optional
    a touchstone:Requirement ;
    touchstone:level "MAY" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server, touchstone:Client ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#access-inbox-property> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#access-inbox-property> ;
    touchstone:summary "The inbox property is optional." ;
    touchstone:clauseText """This property is OPTIONAL.""" ;
    touchstone:clauseHash "sha256-eb84cd6f42be85375f665392b04ec6332f98e77033b7d9e8be08b587db835ac9" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:access-access-collection
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server, touchstone:Client ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#access-property> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#access-property> ;
    touchstone:summary "The access property is a collection of one or more objects." ;
    touchstone:clauseText """The value of the access property MUST be a collection of one or more objects.""" ;
    touchstone:clauseHash "sha256-de7a6203a89c08be83c7bf3c311d576462ad9be73cbd154663acf15aed677c80" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:access-access-required
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server, touchstone:Client ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#access-property> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#access-property> ;
    touchstone:summary "The access property is required." ;
    touchstone:clauseText """This property is REQUIRED.""" ;
    touchstone:clauseHash "sha256-734b933ebef24f55bf7724fbf2a2fb4c904e35149c12d59f00e5aa4be47a6201" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:policy-type-access-policy
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server, touchstone:Client ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#odrl-type> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#odrl-type> ;
    touchstone:summary "A policy type includes AccessPolicy; additional types are allowed." ;
    touchstone:clauseText """The value of the type property MUST be one or more terms and absolute URL strings, and MUST include the term AccessPolicy. Additional type values MAY be included.""" ;
    touchstone:clauseHash "sha256-16e761e6006822aca1232cd0d245c06eabd1898e6386d3f809ef203a82dbb221" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:policy-type-required
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server, touchstone:Client ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#odrl-type> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#odrl-type> ;
    touchstone:summary "The policy type property is required." ;
    touchstone:clauseText """The property is REQUIRED.""" ;
    touchstone:clauseHash "sha256-d4af36d75135861914a21f514a3dbc57e3ed626a3f74a59e484eab7759b8f58f" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:policy-action-values
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server, touchstone:Client ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#odrl-action> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#odrl-action> ;
    touchstone:summary "The action property is a collection of server-recognized operation strings; read, modify, create and delete are mandatory to support." ;
    touchstone:clauseText """The value of the action property MUST be a collection of one or more strings. Each value MUST correspond to an operation recognized by the server. The following values MUST be supported: read, modify, create, and delete. The read, modify, and delete values are defined by the ODRL Vocabulary. The create value is defined by this specification.""" ;
    touchstone:clauseHash "sha256-d629bc3da81fb3f4d7b46d64b6984d2aab947847149e959484150cb4604217ef" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:policy-action-required
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server, touchstone:Client ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#odrl-action> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#odrl-action> ;
    touchstone:summary "The action property is required." ;
    touchstone:clauseText """This property is REQUIRED.""" ;
    touchstone:clauseHash "sha256-734b933ebef24f55bf7724fbf2a2fb4c904e35149c12d59f00e5aa4be47a6201" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:policy-assignee-uri-foaf-agent
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server, touchstone:Client ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#odrl-assignee> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#odrl-assignee> ;
    touchstone:summary "The assignee is a URI; public access may be assigned via foaf:Agent." ;
    touchstone:clauseText """The value of the assignee property MUST be a URI. Public access MAY be assigned using the Agent class from the FOAF vocabulary, identified by the URI http://xmlns.com/foaf/0.1/Agent.""" ;
    touchstone:clauseHash "sha256-5d9c65e20b8011a79e16bad86347a0142db230484d20776a9d728d8422b94c53" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

