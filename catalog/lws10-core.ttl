@prefix req:     <https://example.org/touchstone/req/lws10-core/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

## ---- LWS media type: content negotiation ------------------------------------

## The seed req:conneg-media-type-equivalence (successor to the Gate-1 seed
## req:container-representation-conneg, D-0040) is retired: the 19 October 2026 draft
## no longer makes application/lws+json, application/ld+json and application/json
## equivalent, and requires only application/lws+json, with the Content-Type of the
## selected representation (w3c/lws-protocol#253). Its successor,
## req:conneg-lws-json-honored, is a Draft entry in the generated section (DECISIONS.md D-0100).

## ---- Operations: create -----------------------------------------------------

req:create-post-201-location-links
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#create-resource> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#create-resource> ;
    touchstone:summary "POST create returns 201 with Location and atomic server-managed Link metadata (rel=up, rel=linkset)." ;
    touchstone:clauseText """On success, the server MUST return the 201 status code with the new URI in the Location header. The server MUST include Link headers for key server-managed metadata, including a link to the parent container (rel="up"), and a link to the created resource's dedicated linkset resource (rel="linkset"; type="application/linkset+json"). Additional links SHOULD include rel="type" (indicating https://www.w3.org/ns/lws#Container or https://www.w3.org/ns/lws#DataResource). The body MAY be empty or include a minimal representation of the resource. All metadata creation and linking MUST be atomic with the resource creation to maintain consistency.""" ;
    touchstone:clauseHash "sha256-6808523b25cc42196caf104571dd803d918e6237c1778147d809e65ace11dd87" ;
    touchstone:status touchstone:Approved ;
    dcterms:created "2026-07-16"^^xsd:date .

req:create-container-type-link
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server, touchstone:Client ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#create-resource> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#create-resource> ;
    touchstone:summary "Creating a container is signalled by a request Link header rel=type pointing at lws#Container; the server materializes a container accordingly." ;
    touchstone:clauseText """To create a Container, the client MUST include a Link header with rel="type" pointing to the Container type: Link: <https://www.w3.org/ns/lws#Container>; rel="type".""" ;
    touchstone:clauseHash "sha256-073d51753989299e576520bf2f9338edbd10d810f301f3dc8fff5082dbf50516" ;
    touchstone:status touchstone:Approved ;
    dcterms:created "2026-07-16"^^xsd:date .

req:create-post-missing-container-404
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#create-resource> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#create-resource> ;
    touchstone:summary "POST into a nonexistent container yields 404 unless another status code is more appropriate." ;
    touchstone:clauseText """If the target container /alice/notes/ does not exist, the server MUST return a 404 error status unless another status code is more appropriate.""" ;
    touchstone:clauseHash "sha256-e147ae5ad9a2d926b69f88ed76b5015edca88f1cb8a5bb31d3798ee252af5928" ;
    touchstone:status touchstone:Approved ;
    dcterms:created "2026-07-16"^^xsd:date .

## ---- Operations: read -------------------------------------------------------

req:get-data-resource-content-range-etag
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#read-resource> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#read-resource> ;
    touchstone:summary "GET on a data resource returns 200 with the stored Content-Type; range-request support and an ETag header are mandatory." ;
    touchstone:clauseText """GET (non-container resource) – Retrieve a resource's content: Send GET to the resource URI for full content (if authorized). Respond with 200 OK, body containing the data, and Content-Type matching the stored media type. Servers MUST support range requests per [RFC7233] for partial retrieval. Responses MUST include an ETag header as defined in [RFC9110].""" ;
    touchstone:clauseHash "sha256-986becc6822ff910fab1f1141a4bd8b7aeeb85f8b0c6ca045202ba545829e7da" ;
    touchstone:status touchstone:Approved ;
    dcterms:created "2026-07-16"^^xsd:date .

req:head-parity-with-get
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#read-resource> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#read-resource> ;
    touchstone:summary "HEAD is supported for containers and data resources, returning the same headers as GET (Content-Type, Link metadata) without a body." ;
    touchstone:clauseText """HEAD (any resource or container) – Headers/metadata only: The LWS server MUST support HEAD [RFC9110] for both containers and non-containers, returning the same headers as GET (including Content-Type, Link for metadata) but without a body. This enables metadata retrieval without transferring content.""" ;
    touchstone:clauseHash "sha256-07253b9127b62fe1e6e0be3ffce2149fceab5f20336e7b6c1d21f6631abc8e6e" ;
    touchstone:status touchstone:Approved ;
    dcterms:created "2026-07-16"^^xsd:date .

## ---- Operations: update -----------------------------------------------------

## The Gate-1 seed req:patch-json-merge-patch-baseline is retired: the 5 October 2026 draft
## makes JSON Patch (RFC 6902) the baseline patch format in place of JSON Merge Patch
## (w3c/lws-protocol#255). That is a different obligation, so its successor,
## req:patch-json-patch-baseline, is a Draft entry in the generated section (DECISIONS.md D-0086).

## ---- Operations: resource metadata ------------------------------------------

req:link-up-on-non-root-resources
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#metadata-0> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#metadata-0> ;
    touchstone:summary "Every response for a non-root resource carries a Link header rel=up pointing at the parent container." ;
    touchstone:clauseText """Containment: Servers MUST include a Link header with rel="up" pointing to the parent container for any non-root resource.""" ;
    touchstone:clauseHash "sha256-f3a3a7b44d554d76cc9080e408b6d979fe29fa15f6280c278118b8a7477c562b" ;
    touchstone:status touchstone:Approved ;
    dcterms:created "2026-07-16"^^xsd:date .

## The Gate-1 seed req:linkset-accept-patch-advertised is retired for the same reason: the
## linkset must now advertise application/json-patch+json. Its successor,
## req:linkset-accept-patch-json-patch, is a Draft entry in the generated section (D-0086).

## ---- Operations: delete ------------------------------------------------------

req:delete-non-empty-container-409-depth
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server, touchstone:Client ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#delete-resource> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#delete-resource> ;
    touchstone:summary "Non-recursive DELETE of a non-empty container is rejected with 409; recursive deletion is requested via Depth: infinity." ;
    touchstone:clauseText """For container resources, the server defaults to non-recursive deletion. If the container is not empty and recursion is not requested, the server MUST reject the request with 409 Conflict. Servers MAY support recursive deletion of all contained resources within the container that is being deleted. Clients MUST use the Depth: infinity header to request for a recursive delete, as defined in [RFC4918].""" ;
    touchstone:clauseHash "sha256-01c0a1b64ea5a4fadb47e80e7e15af331f60b1553cf77a023e1499ce363432d9" ;
    touchstone:status touchstone:Approved ;
    dcterms:created "2026-07-16"^^xsd:date .

## Narrowed successor to the Gate-1 seed req:delete-updates-parent-listing-etag: the
## 21 September 2026 draft dropped "its ETag MUST be updated to reflect the change" and
## kept the rest word for word, so the Approved status carries over (DECISIONS.md D-0057).
req:delete-removes-from-parent-listing
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#delete-resource> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#delete-resource> ;
    touchstone:summary "Deleting a resource atomically removes it from the parent container items list; the parent totalItems SHOULD update." ;
    touchstone:clauseText """Deletion and Containment: When a resource is deleted, the server MUST atomically remove it from its parent container's items list. The parent container's totalItems count SHOULD be updated accordingly.""" ;
    touchstone:clauseHash "sha256-4ce851e74ef1859e61123fc5fcdfcf33e1ad22b4c487d272862d9a75398f49f7" ;
    touchstone:status touchstone:Approved ;
    dcterms:created "2026-09-30"^^xsd:date .

## ---- Containers ---------------------------------------------------------------

req:container-empty-items-array
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#container-properties> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#container-properties> ;
    touchstone:summary "A container representation's items is an array of contained-resource descriptions; an empty container yields an empty array." ;
    touchstone:clauseText """items: An array of contained resource descriptions (see below). If the container is empty, this MUST be an empty array. When the container listing is paginated, items contains only the current page of resources; see Pagination for details.""" ;
    touchstone:clauseHash "sha256-e44a4b6cb04567837ed30c6dc6d1e70221814dfb0c90d227536480934bfb2718" ;
    touchstone:status touchstone:Approved ;
    dcterms:created "2026-07-16"^^xsd:date .

req:contained-resource-type-values
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:appliesTo touchstone:Server ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#contained-resource-description> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20261019/#contained-resource-description> ;
    touchstone:summary "A contained resource description's type is DataResource or Container (or an array containing at least one of the two)." ;
    touchstone:clauseText """type: The type of the resource. MUST be "DataResource" or "Container", or an array containing at least one of these two strings. Servers MAY include additional user-defined types as URIs (e.g., ["DataResource", "http://example.org/customType"]).""" ;
    touchstone:clauseHash "sha256-b5fd49783e768f0c96a31fb4e98724863aad5eb92a041c514bb2833a56f5baf9" ;
    touchstone:status touchstone:Approved ;
    dcterms:created "2026-07-16"^^xsd:date .

