req:authn-issuer-trust-out-of-band
    a touchstone:Requirement ;
    touchstone:level "MAY" ;
    touchstone:specModule "lws10-core" ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#authentication-validation> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20260821/#authentication-validation> ;
    touchstone:summary "Verifier-issuer trust may be established out of band; authentication suites define additional mechanisms." ;
    touchstone:clauseText """Validation of an authentication credential requires a trust relationship between the verifier and issuer of the credential. This trust relationship MAY be established through an out-of-band mechanism. Any additional mechanisms for establishing trust between a verifier and an issuer are outlined in specific authentication suites.""" ;
    touchstone:clauseHash "sha256-ff954af8f9533343f22143d3977456dbf843dc205c454ca347ec190caccf5560" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

req:authn-credential-signed
    a touchstone:Requirement ;
    touchstone:level "MUST" ;
    touchstone:specModule "lws10-core" ;
    touchstone:section <https://www.w3.org/TR/lws10-core/#authentication-validation> ;
    touchstone:sourceDraft <https://www.w3.org/TR/2026/WD-lws10-core-20260821/#authentication-validation> ;
    touchstone:summary "Authentication credentials are signed; asymmetric cryptography is recommended." ;
    touchstone:clauseText """An authentication credential MUST be signed. It is RECOMMENDED that the signature uses asymmetric cryptography.""" ;
    touchstone:clauseHash "sha256-ac22b372748ce86af1d8c96290bf66910f303d386937442ca7c44db166c10381" ;
    touchstone:status touchstone:Draft ;
    dcterms:created "2026-09-02"^^xsd:date .

