<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.ebremer.touchstone</groupId>
    <artifactId>touchstone</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>harness-mcp</artifactId>
  <name>Touchstone :: MCP Server</name>
  <description>Spring Boot + Spring AI MCP server (WebMVC transport on Jetty); thin adapter over harness-core.</description>

  <dependencyManagement>
    <dependencies>
      <!-- Ahead of spring-boot-dependencies deliberately. A child's own dependencyManagement is
           consulted before the parent's, so the root pom's jetty-bom import does not reach this
           module; without this, Boot's BOM would decide the Jetty version here (12.1.10) while
           the declared pin said something else, and "which Jetty is this" would have two answers
           in one repository. DECISIONS.md D-0044. -->
      <dependency>
        <groupId>org.eclipse.jetty</groupId>
        <artifactId>jetty-bom</artifactId>
        <version>${jetty.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- jetty-bom covers only the core artifacts; the servlet and websocket layers Boot's
           Jetty starter pulls live under org.eclipse.jetty.ee11 and need their own BOM. Jetty
           releases the two in lockstep, so a build carrying 12.1.11 core with a 12.1.10 servlet
           layer is a configuration nobody upstream tests. -->
      <dependency>
        <groupId>org.eclipse.jetty.ee11</groupId>
        <artifactId>jetty-ee11-bom</artifactId>
        <version>${jetty.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.ai</groupId>
        <artifactId>spring-ai-bom</artifactId>
        <version>${spring-ai.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>com.ebremer.touchstone</groupId>
      <artifactId>harness-core</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- Servlet stack is REQUIRED (DESIGN.md paragraph 4): the WebFlux starter would pull Netty. -->
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
      <exclusions>
        <exclusion>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-starter-tomcat</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.apache.tomcat.embed</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jetty</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- End-to-end target for the MCP tools: the in-memory reference LWS server. The MCP
         client used by the end-to-end test is already on the classpath transitively. -->
    <dependency>
      <groupId>com.ebremer.touchstone</groupId>
      <artifactId>harness-fixtures</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!-- Tomcat must never reach this classpath — build-time enforcement of DESIGN.md paragraph 4. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>ban-tomcat</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>org.apache.tomcat:*</exclude>
                    <exclude>org.apache.tomcat.embed:*</exclude>
                    <exclude>org.springframework.boot:spring-boot-starter-tomcat</exclude>
                    <exclude>org.springframework.boot:spring-boot-tomcat</exclude>
                  </excludes>
                  <includes>
                    <!-- Jakarta EL implementation shipped by spring-boot-starter-jetty itself; not a
                         servlet container. The invariant is "the web server is Jetty" (see the boot
                         smoke test), not "no jar under the Tomcat groupId". DECISIONS.md D-0011. -->
                    <include>org.apache.tomcat.embed:tomcat-embed-el</include>
                  </includes>
                  <searchTransitive>true</searchTransitive>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
