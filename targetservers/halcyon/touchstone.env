# How run-all.sh tests this target: a bash file it sources, with $ORIGIN and $TARGET set (README.md, "Testing them
# all"). Paths are relative to the target's URL, $ORIGIN/targets/$TARGET.
TS_NAME=Halcyon
TS_LANGUAGE=Java
TS_BASE=lws/touchstone/      # the container runs go in, made as alice when it is missing
TS_STORAGE=lws/              # the storage: the audience of its access tokens
TS_ISSUER=                   # the authorization server, after the URL ("" is the URL itself)
# alice owns the storage as a did:key, and alice and bob get their tokens by exchanging did:key credentials (Halcyon
# keeps its signing key in its database, where the harness cannot read it).
TS_AUTH=didkey
# The fixture host over HTTPS (the run's CA is trusted, compose.local.yaml): it resolves did:web, and takes only https CID subjects, and did:web
# documents are only ever fetched over HTTPS.
TS_FIXTURES=https://fixtures
TS_CAPABILITIES="Authentication"
