# How run-all.sh tests this target: a bash file it sources, with $ORIGIN and $TARGET set (README.md, "Testing them
# all"). Paths are relative to the target's URL, $ORIGIN/targets/$TARGET.
TS_NAME=sparq-lws-core
TS_LANGUAGE=Rust
TS_BASE=                     # the storage root itself: it answers anonymous callers 401
TS_STORAGE=
TS_ISSUER=
# The harness mints alice's and bob's tokens with the server's own key (alice, as the fixture host serves her,
# owns the storage), and signs SAML assertions with an identity provider key the server trusts.
TS_AUTH=harness
TS_KEY_CMD=(cat /data/as-key.json)
TS_KEY_FORMAT=jwk
TS_SAML=yes
TS_CAPABILITIES="Authentication, HarnessIssuedTokens"
