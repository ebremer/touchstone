# Settings for compose.yaml (README.md). Copy to .env beside it.

# The origin the router is published at, behind a TLS proxy; targets are at <origin>/targets/<name>/.
LWS_ORIGIN=https://storage.example
# Where the router listens.
LWS_TARGETS_BIND=127.0.0.1:8480

# Each storage's owner: the agent with full control, usually the agent Touchstone plays as alice.
HALCYON_OWNER=https://fixtures.example/halcyon/agents/alice
# OpenID Providers whose ID Tokens Halcyon accepts, space separated; empty for any a WebID names.
HALCYON_ALLOWED_ISSUERS=
# WebIDs and did:keys, space separated.
LWS_SERVER_OWNER=https://fixtures.example/lws-server/agents/alice
# For a plain-HTTP LWS_ORIGIN only.
#LWS_REQUIRE_HTTPS=false
# Further lws.properties lines for lws-server, e.g. more accepted credential audiences:
#LWS_SERVER_PROPERTIES="lws.audience=https://storage.example/targets/lws-server https://idp-audience.example"
SPARQ_LWS_OWNER=https://fixtures.example/sparq-lws/agents/alice
# Trusted SAML identity providers, as JSON: {"<entity ID>": "<PEM public key>"}. Optional.
SPARQ_LWS_SAML_IDPS=
CSS_OWNER=https://fixtures.example/css/agents/alice
LWS_DRUPAL_OWNER=https://fixtures.example/lws-drupal/agents/alice
# lwsd's writers: comma or space separated.
LWSD_OWNER=https://fixtures.example/lwsd/agents/alice
# The password of lws-drupal's database; any long random string.
LWS_DRUPAL_DB_PASSWORD=

# Another commit of an implementation (each Dockerfile has the default):
#HALCYON_REF=
#LWS_SERVER_REF=
#SPARQ_REF=
#CSS_REF=
#LWS_DRUPAL_REF=
#LWS_CLIENT_REF=
#LWSD_REF=
