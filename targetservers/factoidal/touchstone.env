# How run-all.sh tests this target: a bash file it sources, with $ORIGIN and $TARGET set (README.md, "Testing them
# all"). Paths are relative to the target's URL, $ORIGIN/targets/$TARGET.
TS_NAME=Factoidal
TS_LANGUAGE="Lean 4 (wasm in Node.js)"
# Tested at an origin of its own, not through the router: 0.18.0 writes root-relative references (Location: /x/,
# Link: </>; rel="up"), right only when the storage is at the root of an origin (compose.local.yaml).
TS_URL=http://factoidal:8080
TS_BASE=touchstone/
TS_STORAGE=.well-known/lws-storage   # the storage: the audience of its access tokens (a token for the root is refused)
TS_ISSUER=
TS_AUTH=harness
# Its signing keys, a JWK Set; the harness takes the first.
TS_KEY_CMD=(sh -c 'factoidal authz-keys /data/as --private | node -e "process.stdout.write(JSON.stringify(JSON.parse(require(\"fs\").readFileSync(0, \"utf8\")).keys[0]))"')
TS_KEY_FORMAT=jwk
TS_CAPABILITIES="Authentication, HarnessIssuedTokens"
