# How run-all.sh tests this target: a bash file it sources, with $ORIGIN and $TARGET set (README.md, "Testing them
# all"). Paths are relative to the target's URL, $ORIGIN/targets/$TARGET.
TS_NAME=lws-drupal
TS_LANGUAGE=PHP
TS_BASE=lws/touchstone/root/  # the storage root
TS_STORAGE=lws/touchstone/
TS_REGISTER=storage           # so Touchstone finds the storage root in the storage description (D-0099)
TS_ISSUER=
TS_AUTH=harness
# The fixture host over HTTPS (the run's CA is trusted, compose.local.yaml): it resolves did:web, and did:web
# documents are only ever fetched over HTTPS.
TS_FIXTURES=https://fixtures
TS_KEY_CMD=(sh -c 'cat "$(ls -t /data/private/lws_authz/keys/*.jwk | head -1)"')
TS_KEY_FORMAT=jwk
TS_CAPABILITIES="Authentication, HarnessIssuedTokens"
TS_PROPERTIES=("as.clientId: $TS_FIXTURES/$TARGET/")   # lws-drupal takes only URIs as client IDs
