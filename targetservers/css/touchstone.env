# How run-all.sh tests this target: a bash file it sources, with $ORIGIN and $TARGET set (README.md, "Testing them
# all"). Paths are relative to the target's URL, $ORIGIN/targets/$TARGET.
TS_NAME="Community Solid Server"
TS_LANGUAGE=TypeScript
TS_BASE=touchstone/runs/     # a container in the pod: the pod root is public-read
TS_STORAGE=touchstone/
TS_ISSUER=/
TS_AUTH=harness
TS_WARMUP=.well-known/lws/jwks   # CSS makes its signing key when first asked for it
TS_KEY_CMD=(cat '/data/files/.internal/lws/keys/lws-jwks$.json')
TS_KEY_FORMAT=css-jwks
TS_CAPABILITIES="Authentication, HarnessIssuedTokens"
