# build output
target/

# local run artifacts (reports are per-run output, not source)
runs/
runs-*/
# generated by the secured reference scenario launcher
targets-secured.yaml

# IDE
.idea/
*.iml
.vscode/
.classpath
.project
.settings/

# OS noise
.DS_Store
Thumbs.db

# python tooling
__pycache__/
*.pyc

# definitions checks (tools/definitions): build output and installed packages
tools/definitions/build/
tools/definitions/node_modules/
# spec-drift check (tools/extractor/check_published.py): fetched drafts
tools/extractor/build/

# starter kits (driver/kits): each toolchain's build output
driver/kits/*/build/
driver/kits/*/bin/
driver/kits/*/obj/
driver/kits/*/.build/
driver/kits/*/node_modules/
driver/kits/*/vendor/
driver/kits/rust/Cargo.lock

# misc
*.log
dependency-reduced-pom.xml

# local agent state
.claude/settings.local.json

# a filled-in copy of targetservers/.env.example (it holds a database password)
targetservers/.env
# run-all.sh: keys and settings per project, and reports
targetservers/.local/
targetservers/runs/
